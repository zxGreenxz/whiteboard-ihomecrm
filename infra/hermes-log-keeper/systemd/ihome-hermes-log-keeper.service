# Giữ log dịch vụ Hermes ra /var/log/ihome-hermes (journald RAM của VPS chỉ giữ ~2 giờ). Cài theo infra/hermes-log-keeper/README.md.
# Chỉ ĐỌC journal (nhóm systemd-journal), chỉ GHI thư mục log + con trỏ riêng; không mạng, không đổi cấu hình journald.
[Unit]
Description=iHome Hermes - giu log dich vu (journald RAM chi giu ~2 gio)
Documentation=file:///opt/ihome-hermes/current/infra/hermes-log-keeper/README.md
After=local-fs.target

[Service]
Type=oneshot
DynamicUser=yes
SupplementaryGroups=systemd-journal
UMask=0027
LogsDirectory=ihome-hermes
LogsDirectoryMode=0750
StateDirectory=ihome-hermes-log-keeper
StateDirectoryMode=0750
Environment=LOG_DIR=/var/log/ihome-hermes STATE_DIR=/var/lib/ihome-hermes-log-keeper RETENTION_DAYS=14 MAX_TOTAL_MB=300
ExecStart=/usr/bin/bash /opt/ihome-hermes/current/infra/hermes-log-keeper/log-keeper.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=128M
CPUQuota=25%
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
