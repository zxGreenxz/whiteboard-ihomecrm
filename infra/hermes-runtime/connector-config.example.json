{
  "version": 2,
  "mode": "connector",
  "supabase": {
    "url": "https://abcdefghijklmnopqrst.supabase.co",
    "publishableKey": "sb_publishable_replace_with_project_publishable_key"
  },
  "store": {
    "projectRef": "abcdefghijklmnopqrst",
    "host": "db.abcdefghijklmnopqrst.supabase.co",
    "role": "hermes_store_host",
    "passwordFile": "/etc/ihome-hermes/store-password",
    "caFile": "/etc/ihome-hermes/store-ca.pem"
  },
  "encryption": {
    "activeKeyVersion": "v1",
    "keys": [{ "version": "v1", "file": "/etc/ihome-hermes/keys/v1.bin" }]
  },
  "http": {
    "allowedHosts": ["hermes-crm.example.com", "127.0.0.1:8740"],
    "allowedOrigins": ["https://crm.example.com"]
  },
  "stateRoot": "/var/lib/ihome-hermes-connector",
  "listenPort": 8740,
  "limits": {
    "requestsPerMinute": 60,
    "toolCallsPerMinute": 30,
    "callTimeoutMs": 20000,
    "maintenanceWaitMs": 5000
  }
}
