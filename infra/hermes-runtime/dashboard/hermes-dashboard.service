[Unit]
Description=Hermes owner dashboard (v0.22.2, authenticated loopback)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target hermes-dashboard-proxy.socket
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ihome-hermes-dashboard/current
StateDirectory=ihome-hermes-dashboard
StateDirectoryMode=0700
ExecStart=/opt/ihome-hermes/node/bin/node /opt/ihome-hermes-dashboard/current/launcher.mjs start
ExecStop=/opt/ihome-hermes/node/bin/node /opt/ihome-hermes-dashboard/current/launcher.mjs stop
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
