[Unit]
Description=iHomeCRM connector for independent Hermes
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/ihome-hermes/connector.json
ConditionPathIsDirectory=/var/lib/ihome-hermes-connector

[Service]
Type=simple
User=ihome-hermes
Group=ihome-hermes
WorkingDirectory=/opt/ihome-hermes/current
ExecStart=/opt/ihome-hermes/node/bin/node /opt/ihome-hermes/current/infra/hermes-runtime/host-cli.mjs --config /etc/ihome-hermes/connector.json
Restart=no
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=infinity
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ihome-hermes-connector
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
