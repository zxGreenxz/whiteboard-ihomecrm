# TLS front door for the private media gateway.
#
# The gateway itself binds loopback only; this is the sole public path to it.
# Certificates are issued over HTTP-01, which means the A record for this name
# must already resolve to this host - Caddy will retry until it does, so a
# missing DNS record shows up as a pending certificate rather than a broken
# service.

openclaw-media.chillhome.io.vn {
	# The bridge sends whole files in one PUT; the gateway caps the size itself
	# from the ticket, but the front door must not truncate the body first.
	request_body {
		max_size 16MB
	}

	# Everything except the one route the gateway serves is refused here rather
	# than forwarded, so the gateway is never asked about paths it does not own.
	@object path /v1/object
	handle @object {
		reverse_proxy 127.0.0.1:8081 {
			# Uploads are not fast; the gateway's own request timeout is 60s.
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		respond "not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Logs go to the journal, which is where the packaged unit expects them: it
	# runs with ProtectSystem=strict and only /var/lib/caddy is writable, so a
	# file sink here makes every config reload fail with a permission error.
	log {
		format json
	}
}
