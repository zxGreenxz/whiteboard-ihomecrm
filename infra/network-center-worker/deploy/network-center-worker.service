[Unit]
Description=iHomeCRM Network Center worker (immutable release)
Wants=network-online.target
Requires=wg-quick@wg0.service docker.service ihome-network-center-firewall.service
After=network-online.target wg-quick@wg0.service ihome-network-center-firewall.service
After=docker.service
ConditionPathExists=/opt/ihome-network-center/state/current.release

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
Environment=NETWORK_CENTER_ROOT=/opt/ihome-network-center
ExecStart=/opt/ihome-network-center/bin/activate-release.sh start-current
ExecStop=/opt/ihome-network-center/bin/activate-release.sh stop-current
TimeoutStartSec=15min
TimeoutStopSec=6min
KillMode=none

[Install]
WantedBy=multi-user.target
