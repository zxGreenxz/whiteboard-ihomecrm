# Non-secret deployment settings only. Copy to .env on the VPS.
NETWORK_CENTER_EDGE_URL=https://PROJECT.supabase.co/functions/v1/network-center-worker
NETWORK_CENTER_WORKER_KEY=vultr-network-center-01
NETWORK_CENTER_POLL_INTERVAL_MS=60000
NETWORK_CENTER_COMMAND_POLL_INTERVAL_MS=15000
NETWORK_CENTER_HEARTBEAT_INTERVAL_MS=60000
NETWORK_CENTER_CONNECTION_REFRESH_MS=60000
NETWORK_CENTER_REQUEST_TIMEOUT_MS=10000
NETWORK_CENTER_COMMAND_TIMEOUT_MS=60000
NETWORK_CENTER_LEASE_SECONDS=90
NETWORK_CENTER_RELEASE_SHA=<40-char-reviewed-sha>
NETWORK_CENTER_POLL_CONCURRENCY=3
NETWORK_CENTER_COMMAND_CONCURRENCY=3
NETWORK_CENTER_COMMAND_CLAIM_LIMIT=3
NETWORK_CENTER_SFTP_CONCURRENCY=1
NETWORK_CENTER_EMERGENCY_STOP=true

# Host orchestration settings; their contents are never committed.
NETWORK_CENTER_RUNTIME_SECRET_DIR_HOST=/run/ihome-network-center/secrets
NETWORK_CENTER_BACKUP_DIR_HOST=/opt/ihome-network-center/backups
NETWORK_CENTER_ENV_FILE=/opt/ihome-network-center/config/worker.env
NETWORK_CENTER_IMAGE_REF=ihome-network-center-worker:<40-char-reviewed-sha>
NETWORK_CENTER_CONTAINER_NAME=ihome-network-center-worker

# Container-side secret references. Values live in owner-only files.
NETWORK_CENTER_WORKER_SECRET_FILE=/run/secrets/network-center/worker-secret
NETWORK_CENTER_CREDENTIALS_FILE=/run/secrets/network-center/router-credentials.json
NETWORK_CENTER_BACKUP_DIR=/var/lib/network-center/backups
