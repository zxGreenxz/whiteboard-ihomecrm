+// NotifyRTSPReader wakes sources waiting for their first downstream PLAY.
+func (s *Stream) NotifyRTSPReader() {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	select {
+	case <-s.hasReaders:
+	default:
+		close(s.hasReaders)
+	}
+}
+
+// WaitForPlaybackReader avoids losing the first recorded keyframe before a reader joins.
+func (s *Stream) WaitForPlaybackReader(ctx context.Context) error {
+	select {
+	case <-s.hasReaders:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
