+	require.Nil(t, pa.stream, "new viewers must not attach to the draining stream")
+	require.Nil(t, pa.source)
+	require.Equal(t, 1, stops)
+	require.Equal(t, pathOnDemandStateInitial, pa.onDemandPublisherState)
+
+	next := &ihomeDelayedPublisher{}
+	publish(next)
+	require.NotSame(t, previous, pa.stream)
+	current := pa.stream
+	pa.doRemovePublisher(defs.PathRemovePublisherReq{Author: old, Res: make(chan struct{})})
+	require.Same(t, current, pa.stream, "late teardown of the old encoder must preserve the new stream")
+	require.Same(t, next, pa.source)
+	require.False(t, next.closed)
+	pa.doRemovePublisher(defs.PathRemovePublisherReq{Author: next, Res: make(chan struct{})})
+}
