+func TestIHomeOnDemandReconnectExcludesDrainingPublisher(t *testing.T) {
+	pa := &path{
+		conf: &conf.Path{Source: "publisher"}, parent: &ihomePathParent{},
+		readers: make(map[defs.Reader]struct{}), writeQueueSize: 16, rtpMaxPayloadSize: 1472,
+		onDemandPublisherCloseTimer: emptyTimer(), onDemandPublisherReadyTimer: emptyTimer(),
+	}
+	pa.forwardManager = &forward.Manager{Parent: pa}
+	pa.forwardManager.Initialize()
+	defer pa.forwardManager.Stop()
+	publish := func(publisher *ihomeDelayedPublisher) {
+		req := defs.PathAddPublisherReq{Author: publisher,
+			Desc: &description.Session{Medias: []*description.Media{test.UniqueMediaH264()}},
+			Res:  make(chan defs.PathAddPublisherRes, 1)}
+		pa.doAddPublisher(req)
+		require.NoError(t, (<-req.Res).Err)
+	}
+	old := &ihomeDelayedPublisher{}
+	publish(old)
+	previous := pa.stream
+	pa.onDemandPublisherState = pathOnDemandStateClosing
+	stops := 0
