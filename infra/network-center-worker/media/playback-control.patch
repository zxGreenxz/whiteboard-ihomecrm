@@ -0,0 +1,30 @@
+package rtsp
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIHomePlaybackRTPContinuity(t *testing.T) {
+	var clock playbackRTPClock
+	origin := time.Now()
+	packet := &rtp.Packet{Header: rtp.Header{Timestamp: 900000, SequenceNumber: 65535, SSRC: 123}}
+	first, pts := clock.normalize(packet, origin, 90000)
+	require.Equal(t, int64(0), pts)
+	require.Equal(t, uint32(900000), packet.Timestamp)                 // Source packet is not mutated.
+	packet.Timestamp, packet.SequenceNumber, packet.SSRC = 100, 9, 999 // Recorder resets on backward seek.
+	next, pts := clock.normalize(packet, origin.Add(time.Second), 90000)
+	require.Equal(t, int64(90000), pts)
+	require.Equal(t, first.SSRC, next.SSRC)
+	require.Equal(t, uint16(0), next.SequenceNumber)
+	sameFrame, samePTS := clock.normalize(packet, origin.Add(1100*time.Millisecond), 90000)
+	require.Equal(t, pts, samePTS)
+	require.Equal(t, next.Timestamp, sameFrame.Timestamp)
+	packet.Timestamp++
+	afterWrap, pts := clock.normalize(packet, origin.Add(14*time.Hour), 90000)
+	require.Greater(t, pts, int64(1<<32)) // Unit PTS remains 64-bit across RTP's 13.3-hour wrap.
+	require.Equal(t, uint32(pts), afterWrap.Timestamp)
+}
