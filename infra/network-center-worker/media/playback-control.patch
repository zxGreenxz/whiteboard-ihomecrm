+type playbackRTPClock struct {
+	initialized          bool
+	inputTimestamp, ssrc uint32
+	outputTimestamp      int64
+	sequence             uint16
+	origin               time.Time
+}
+
+func (c *playbackRTPClock) normalize(pkt *rtp.Packet, now time.Time, rate int) (*rtp.Packet, int64) {
+	if !c.initialized {
+		c.initialized = true
+		c.origin = now
+		c.inputTimestamp, c.ssrc, c.sequence = pkt.Timestamp, pkt.SSRC, pkt.SequenceNumber
+	} else if c.inputTimestamp != pkt.Timestamp {
+		c.inputTimestamp = pkt.Timestamp
+		c.outputTimestamp = max(c.outputTimestamp+1, int64(now.Sub(c.origin).Seconds()*float64(rate)))
+	}
+	pkt = pkt.Clone()
+	pkt.Timestamp, pkt.SequenceNumber, pkt.SSRC = uint32(c.outputTimestamp), c.sequence, c.ssrc
+	c.sequence++
+	return pkt, c.outputTimestamp
+}
