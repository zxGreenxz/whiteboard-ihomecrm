+func TestIHomePlaybackControl(t *testing.T) {
+	var strm *gortsplib.ServerStream
+	var plays atomic.Int32
+	var describes atomic.Int32
+	var setups atomic.Int32
+	playEntered := make(chan struct{})
+	acceptPlay := make(chan struct{})
+	var session *gortsplib.ServerSession
+	server := &gortsplib.Server{RTSPAddress: "127.0.0.1:8555", Handler: &testServer{
+		onDescribe: func(*gortsplib.ServerHandlerOnDescribeCtx) (*base.Response, *gortsplib.ServerStream, error) {
+			describes.Add(1)
+			return &base.Response{StatusCode: base.StatusOK}, strm, nil
+		},
+		onSetup: func(*gortsplib.ServerHandlerOnSetupCtx) (*base.Response, *gortsplib.ServerStream, error) {
+			setups.Add(1)
+			return &base.Response{StatusCode: base.StatusOK}, strm, nil
+		},
+		onPlay: func(ctx *gortsplib.ServerHandlerOnPlayCtx) (*base.Response, error) {
+			switch plays.Add(1) {
+			case 1:
+				session = ctx.Session
+			case 2:
+				require.Same(t, session, ctx.Session)
+				require.Equal(t, base.HeaderValue{"npt=120-"}, ctx.Request.Header["Range"])
+				require.Equal(t, base.HeaderValue{"8"}, ctx.Request.Header["Scale"])
+				close(playEntered)
+				<-acceptPlay
+			case 3:
+				require.Same(t, session, ctx.Session)
+				require.Empty(t, ctx.Request.Header["Scale"])
+			}
+			return &base.Response{StatusCode: base.StatusOK}, nil
+		},
+	}}
+	require.NoError(t, server.Start())
+	defer server.Close()
+	strm = &gortsplib.ServerStream{Server: server, Desc: &description.Session{Medias: []*description.Media{test.UniqueMediaH264(), test.UniqueMediaMPEG4Audio()}}}
+	require.NoError(t, strm.Initialize())
+	defer strm.Close()
+	parent := &test.StaticSourceParent{}
+	parent.Initialize()
+	defer parent.Close()
+	source := &rtsp.Source{ReadTimeout: conf.Duration(3 * time.Second), WriteTimeout: conf.Duration(3 * time.Second), WriteQueueSize: 512, Parent: parent}
+	cnf := &conf.Path{RTSPUDPSourcePortRange: []uint{32768, 60999}, RTSPPlaybackRevision: "initial"}
+	require.NoError(t, cnf.RTSPTransport.UnmarshalJSON([]byte(`"tcp"`)))
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	reload := make(chan *conf.Path)
+	go func() {
+		done <- source.Run(defs.StaticSourceRunParams{Context: ctx, ResolvedSource: "rtsp://127.0.0.1:8555/test", Conf: cnf, ReloadConf: reload})
+	}()
+	defer func() { cancel(); require.NoError(t, <-done) }()
+	revision := func() string {
+		info := source.Info()
+		if specific, ok := info.TypeSpecific.(*defs.APIStaticSourceTypeSpecificRTSP); ok {
+			return specific.PlaybackRevision
+		}
+		return ""
+	}
+	require.Eventually(t, func() bool { return revision() == "initial" }, 3*time.Second, 10*time.Millisecond)
+	next := cnf.Clone()
+	next.RTSPRangeType = conf.RTSPRangeTypeNPT
+	next.RTSPRangeStart = "120s"
+	next.RTSPScale = "8"
+	next.RTSPPlaybackRevision = "seek"
+	reload <- next
+	select {
+	case <-playEntered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("missing PLAY")
+	}
+	require.Equal(t, "initial", revision())
+	close(acceptPlay)
+	require.Eventually(t, func() bool { return revision() == "seek" }, time.Second, 10*time.Millisecond)
+	normal := next.Clone()
+	normal.RTSPScale = ""
+	normal.RTSPPlaybackRevision = "normal"
+	reload <- normal
+	require.Eventually(t, func() bool { return revision() == "normal" }, time.Second, 10*time.Millisecond)
+	require.EqualValues(t, 1, describes.Load())
+	require.EqualValues(t, 2, setups.Load()) // Audio and video survive seek/speed changes on the same connection.
+}
