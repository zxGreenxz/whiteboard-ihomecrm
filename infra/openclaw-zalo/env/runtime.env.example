# Copy to /srv/openclaw-runtime/cells/<canonical-cell-id>/runtime.env (0600).
# Secret values belong in /srv/openclaw-runtime/secrets/<cell-id>/, never here.
OPENCLAW_CELL_ID=dddd2000-0000-4000-8000-000000000001
OPENCLAW_ORGANIZATION_ID=dddd0000-0000-4000-8000-000000000001
OPENCLAW_ACCOUNT_ID=dddd1000-0000-4000-8000-000000000001
OPENCLAW_SESSION_GENERATION=1
OPENCLAW_FENCING_TOKEN=replace-with-runtime-fencing-token
OPENCLAW_CONTROL_VERSION=1
OPENCLAW_TAKEOVER_VERSION=1
OPENCLAW_GATEWAY_DEVICE_ID=replace-with-device-id
OPENCLAW_FUNCTIONS_BASE_URL=https://tryymsxyyckgbrmmvozx.supabase.co/functions/v1
OPENCLAW_MEDIA_GATEWAY_URL=https://openclaw-media.chillhome.io.vn/v1/object
OPENCLAW_MEDIA_ALLOWLIST=openclaw-media.chillhome.io.vn
OPENCLAW_ZALO_CUSTOMER_AI_BASE_URL=https://ai.chillhome.io.vn/v1
OPENCLAW_ZALO_CUSTOMER_AI_MODEL=replace-with-reviewed-model-id
OPENCLAW_MAINTENANCE_PRINCIPAL_ID=dddd3000-0000-4000-8000-000000000001
OPENCLAW_AUDIT_SIGNING_KEY_GENERATION=1
OPENCLAW_CELL_IMAGE_SHA256=replace-with-64-lowercase-hex
OPENCLAW_BRIDGE_IMAGE_SHA256=replace-with-64-lowercase-hex
OPENCLAW_MAINTENANCE_IMAGE_SHA256=replace-with-64-lowercase-hex
OPENCLAW_EGRESS_BROKER_IMAGE_SHA256=replace-with-64-lowercase-hex
OPENCLAW_TRANSFER_QUOTA_RECORD=/srv/openclaw-runtime/operations/transfer-quota.json
