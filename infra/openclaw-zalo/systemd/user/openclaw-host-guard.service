[Unit]
Description=OpenClaw Zalo dedicated-host resource guard
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=DOCKER_HOST=unix:///run/user/%U/docker.sock
Environment=OPENCLAW_RUNTIME_ROOT=/srv/openclaw-runtime
EnvironmentFile=/srv/openclaw-runtime/host-guard.env
ExecStart=/opt/ihome-openclaw/infra/openclaw-zalo/scripts/openclaw-host-guard.sh --runtime-env $OPENCLAW_HOST_GUARD_RUNTIME_ENV
TimeoutStartSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/openclaw-runtime/operations

[Install]
WantedBy=default.target
