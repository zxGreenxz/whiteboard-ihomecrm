# Nạp đề xuất bài học vào CRM — user ihome-hermes, login RIÊNG của job nạp (vai hermes_learning_ingest, mật khẩu
# /etc/ihome-hermes/learning-store-password 0600). CHỈ đọc outbox (đề xuất đã che); không thấy báo cáo đủ (private/) hay hồ sơ
# Hermes. Chạy ngay sau kiểm học tập (OnSuccess) và theo lịch riêng 20:55 (ihome-hermes-learning-ingest.timer): job kiểm ngừng
# chạy thì lần nạp theo lịch vẫn gửi "lần kiểm cuối" cũ lên CRM và thoát mã 3 (outbox quá cũ) ⇒ cảnh báo OnFailure.
[Unit]
Description=iHome Hermes - nap de xuat bai hoc vao CRM
Documentation=file:///opt/ihome-hermes/current/infra/hermes-learning-audit/README.md
After=network-online.target
Wants=network-online.target
OnFailure=ihome-hermes-learning-alert@%n.service

[Service]
Type=oneshot
User=ihome-hermes
Group=ihome-hermes
WorkingDirectory=/opt/ihome-hermes/current
ExecStart=/opt/ihome-hermes/node/bin/node /opt/ihome-hermes/current/infra/hermes-learning-audit/ingest.mjs --config /etc/ihome-hermes/learning-audit.json
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadOnlyPaths=/etc/ihome-hermes
InaccessiblePaths=-/var/lib/ihome-hermes-profiles -/var/lib/ihome-hermes-learning-audit/private
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=192M
TimeoutStartSec=5min
