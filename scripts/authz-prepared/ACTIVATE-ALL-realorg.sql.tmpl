begin;

-- 1) Enroll org thật vào MỌI flag canonical
insert into app_private.server_feature_flag_canary_orgs (feature_key, organization_id, added_by)
select f.feature_key, 'aaaa0000-0000-4000-8000-000000000001', null
  from (values
    ('income_expense.create_draft.v1'),
    ('invoice.create.v1'),
    ('salary.lock.v1'), ('salary.unlock.v1'), ('salary.payout.v1'),
    ('shareholder_profit.distribute.v1'), ('shareholder_profit.pay_manager.v1'),
    ('cashbook.create.v1'), ('cashbook.archive.v1'),
    ('cashbook.lock_period.v1'), ('cashbook.opening_adjust.v1')
  ) f(feature_key)
on conflict do nothing;

commit;

