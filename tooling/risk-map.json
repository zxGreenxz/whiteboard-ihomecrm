{
  "$comment": "Phạm vi rủi ro, gate tối thiểu và review độc lập theo PROJECT_CONTRACT §3. Một file có thể khớp nhiều tier.",
  "schemaVersion": 2,
  "scope": {
    "cosmeticPaths": ["src/components/**/*.tsx", "src/pages/**/*.tsx", "src/pages/home/launcherTiles.ts", "src/pages/home/homeLauncher.css", "src/components/**/*.css"],
    "sharedPaths": ["package.json", "package-lock.json", "tsconfig*.json", "vite.config.ts", "eslint*", "ts-baseline.json", "tailwind.config.ts", "postcss.config.js", "components.json", "deno.lock", "tooling/**", ".github/workflows/**", "scripts/lib/**", "scripts/kiem-nhanh-truoc-push.mjs", "scripts/check-risk-classifier.mjs", "scripts/check-test-matrix.mjs", "scripts/check-workflow-paths.mjs", "scripts/promote-to-production.mjs", "src/main.tsx", "src/App.tsx", "src/app/providers/**", "src/integrations/**", "src/components/ui/**", "AGENTS.md", "CLAUDE.md", "AI_RULES.md", "docs/engineering/PROJECT_CONTRACT.md"],
    "schemaPaths": ["supabase/migrations/**", "supabase/migration-policy.json", "supabase/migration-provenance.json", "contracts/surfaces/**", "docs/generated/schema-change-evidence/**"],
    "uiPaths": ["src/components/**", "src/pages/**", "src/app/routes/**", "src/app/capabilities/**", "public/demos/**"],
    "docsPaths": ["docs/**", "docs-site/**", "*.md", "**/*.md"],
    "demoPaths": ["public/demos/personal-finance/**"],
    "realtimePaths": ["src/lib/realtime/**", "src/providers/Realtime*.tsx", "contracts/surfaces/realtime-surface.json"],
    "policyNote": "NGHIÊM NHẤT chỉ để báo cáo. Nghĩa vụ gate là hợp mọi miền; cosmetic cần AST whitelist trong vùng khai, handlers/data/permission không được hạ kiểm. Unknown hoặc dependency chưa map chạy full active."
  },
  "gateProfiles": {
    "docs-only": ["check-docs", "check-doc-counts", "generate-docs-views", "check-baseline-doc"],
    "cosmetic-ui": ["check-ts-baseline", "check-eslint-baseline", "app-build", "bundle-inventory"],
    "ui-behavior": ["check-ts-baseline", "check-eslint-baseline", "app-build", "bundle-inventory", "check-capability-surfaces", "check-route-permission-drift", "check-route-guards"],
    "logic": ["check-ts-baseline", "check-eslint-baseline", "check-strict-islands", "check-new-modules-strict", "check-raw-rpc-callers", "check-rpc-cast-ratchet", "check-error-swallow-ratchet", "check-money-table-dml", "app-build", "bundle-inventory"],
    "schema": ["check-migration-provenance", "normalize-supabase-types", "check-no-auto-apply", "check-management-api-writes", "check-promote-readiness", "check-migration-test-liveness", "check-approver-provenance", "check-residence-dossier-rls", "check-rpc-surface", "check-edge-surface", "check-realtime-surface", "build-org-boundary-inventory", "check-view-invoker", "check-stable-fn-locks", "check-definer-acl", "check-definer-body-authz", "check-permission-catalog", "check-migration-ledger-frozen", "check-forward-migration-idempotent", "measure-org-leak", "test-cross-tenant", "generated-types-drift"],
    "money-auth": ["check-ts-baseline", "check-eslint-baseline", "app-build", "bundle-inventory", "check-money-table-dml", "check-rpc-cast-ratchet", "test-cross-tenant", "measure-org-leak", "check-permission-catalog", "check-definer-acl", "check-definer-body-authz", "check-approver-provenance", "check-residence-dossier-rls", "build-org-boundary-inventory"],
    "shared-tooling": ["check-agent-contract", "check-runtime-matrix", "check-test-matrix", "check-workflow-paths"]
  },
  "tiers": {
    "money": {
      "label": "Tiền",
      "why": "Sai ở đây là sai sổ sách thật của công ty đang vận hành, và thường chỉ lộ ra khi đối chiếu cuối tháng.",
      "crossReview": true,
      "gates": [
        "npm run gate:reconcile-money",
        "npm run gate:reconcile-money-v2",
        "idempotency",
        "concurrency"
      ],
      "paths": [
        "src/hooks/income-expenses/**",
        "src/hooks/useInvoices.ts",
        "src/hooks/useCashBook*.ts",
        "src/hooks/useCashbookClosing.ts",
        "src/hooks/useCashHandovers.ts",
        "src/hooks/useDeposits.ts",
        "src/hooks/usePeriodFees.ts",
        "src/hooks/useUtilityBills.ts",
        "src/hooks/useReconciliations.ts",
        "src/hooks/useShareholderProfit.ts",
        "src/hooks/useManagerSalary.ts",
        "src/hooks/salary-v5/**",
        "src/components/income-expenses/**",
        "src/components/cashbooks/**",
        "src/components/invoices/**",
        "src/components/salary/**",
        "src/lib/contractCreateRpc.ts",
        "src/lib/paymentRecordRpc.ts",
        "src/lib/customerCreditRpc.ts",
        "src/lib/quickEntry/convert.ts",
        "src/hooks/quick-entry/useQuickEntrySave.ts",
        "src/hooks/quick-entry/useQuickEntryFeed.ts",
        "api/salary-v5-cron.js"
      ]
    },
    "authorization": {
      "label": "Phân quyền / RLS",
      "why": "RLS hỏng thì im lặng: truy vấn trả tập rỗng hoặc trả thừa dữ liệu tenant khác, không ném lỗi. Harness chạy bằng superuser sẽ không thấy gì.",
      "crossReview": true,
      "gates": [
        "harness role thật",
        "cross-tenant",
        "E2E vai thật trên môi trường TEST (.e2e-fleet/specs/moi-truong-test.spec.ts)"
      ],
      "paths": [
        "src/lib/permissions.ts",
        "src/lib/permissionPages.ts",
        "src/hooks/useOrganizationAuthorization.ts",
        "src/hooks/useIsAdmin.ts",
        "src/hooks/useIsOrgOwner.ts",
        "src/pages/auth/**",
        "supabase/functions/_shared/**"
      ]
    },
    "migration": {
      "label": "Migration / schema",
      "why": "Không rollback được. Lịch sử legacy đã không replay được, nên mỗi file mới phải tự đứng vững.",
      "crossReview": true,
      "gates": [
        "npm run gate:view-invoker (nếu đụng VIEW)",
        "npm run gate:stable-fn-locks (nếu tạo/sửa FUNCTION)",
        "npm run catalog:check",
        "npm run gen:types && npm run types:normalize (nếu đổi schema)"
      ],
      "paths": [
        "supabase/migrations/**"
      ]
    },
    "infrastructure": {
      "label": "Hạ tầng / vận hành",
      "why": "Chạm vào máy thật, mạng thật, và các thao tác không idempotent (reboot router, xoay secret).",
      "crossReview": true,
      "gates": [
        "verifier của subsystem",
        "dry-run/preflight",
        "diễn tập rollback"
      ],
      "paths": [
        "infra/**",
        "services/**",
        ".github/workflows/**",
        "vercel.json",
        "scripts/apply-*.mjs",
        "scripts/*rollout*.mjs"
      ]
    },
    "agent-contract": {
      "label": "Hợp đồng agent",
      "why": "Sửa sai ở đây làm MỌI phiên agent sau đó làm sai theo hướng dẫn chính thức — lỗi nhân bản chứ không đứng yên.",
      "crossReview": false,
      "gates": [
        "npm run gate:agent-contract"
      ],
      "paths": [
        "CLAUDE.md",
        "AGENTS.md",
        "AI_RULES.md",
        "docs/engineering/PROJECT_CONTRACT.md",
        "tooling/**"
      ]
    },
    "product-surface": {
      "label": "Bề mặt sản phẩm",
      "why": "Route, nav, launcher và permission page phải khớp nhau; kiểm cả cây provider, routes và capabilities.",
      "crossReview": false,
      "gates": [
        "npm run typecheck:baseline",
        "test điều hướng",
        "E2E theo vai trò"
      ],
      "paths": [
        "src/App.tsx",
        "src/app/capabilities/**",
        "src/app/routes/**",
        "src/components/layout/Sidebar.tsx",
        "src/pages/home/launcherTiles.ts"
      ]
    },
    "docs": {
      "label": "Tài liệu",
      "why": "Rủi ro thấp, nhưng số đếm chép tay và trang quá hạn đã từng dẫn người đọc đi sai.",
      "crossReview": false,
      "gates": [
        "npm run docs:check"
      ],
      "paths": [
        "docs/**",
        "README.md",
        "*.md"
      ]
    }
  },
  "notes": [
    "Một file có thể thuộc nhiều tier — tier NGHIÊM NHẤT để báo cáo, hợp gate của MỌI tier khớp để không mất nghĩa vụ.",
    "crossReview=true: một agent thứ hai review độc lập trước khi promote (PROJECT_CONTRACT §3). Chỉ áp dụng cho các tier được đánh dấu.",
    "Danh sách gate ở đây là TỐI THIỂU, không phải đầy đủ: luôn chạy thêm test của chính domain đang sửa."
  ]
}
