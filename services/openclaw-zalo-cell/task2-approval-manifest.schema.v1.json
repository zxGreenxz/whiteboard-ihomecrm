{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/schemas/openclaw-zalo-cell/task2-approval-manifest.schema.v1.json",
  "title": "Reviewed Task 2 approval manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_m",
    "reviewed_tree",
    "authorities",
    "review_reports",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "expected_m": {
      "$ref": "#/$defs/gitObjectId"
    },
    "reviewed_tree": {
      "$ref": "#/$defs/gitObjectId"
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installer",
        "launcher",
        "orchestrator",
        "source_gate",
        "build_helper",
        "evidence_helper"
      ],
      "properties": {
        "installer": {
          "$ref": "#/$defs/installerBinding"
        },
        "launcher": {
          "$ref": "#/$defs/launcherBinding"
        },
        "orchestrator": {
          "$ref": "#/$defs/orchestratorBinding"
        },
        "source_gate": {
          "$ref": "#/$defs/sourceGateBinding"
        },
        "build_helper": {
          "$ref": "#/$defs/buildHelperBinding"
        },
        "evidence_helper": {
          "$ref": "#/$defs/evidenceHelperBinding"
        }
      }
    },
    "review_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M",
        "R"
      ],
      "properties": {
        "M": {
          "$ref": "#/$defs/mReviewReport"
        },
        "R": {
          "$ref": "#/$defs/rReviewReport"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "git",
        "powershell",
        "npm",
        "buildx",
        "docker"
      ],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "size",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/bin/node"
            },
            "version": {
              "const": "v24.15.0"
            },
            "size": {
              "const": 122889056
            },
            "sha256": {
              "const": "d1de76d8edf2fededf6f8b30d244e2c0529ac607923a018283b77e9c74bd932c"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "/usr/bin/git"
            },
            "version": {
              "const": "git version 2.53.0"
            },
            "sha256": {
              "const": "5516c9f362c29376ab9a499a33082f9f611941d8c75930c880e30ad109e39c9a"
            }
          }
        },
        "powershell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "sha256",
            "tree_sha256"
          ],
          "properties": {
            "path": {
              "const": "/opt/openclaw-tools/powershell-7.6.2/pwsh"
            },
            "version": {
              "const": "7.6.2"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "tree_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_path",
            "version",
            "entry_count",
            "root_sha256",
            "cli_path",
            "cli_size",
            "cli_sha256"
          ],
          "properties": {
            "root_path": {
              "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/lib/node_modules/npm"
            },
            "version": {
              "const": "11.12.1"
            },
            "entry_count": {
              "const": 2169
            },
            "root_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "cli_path": {
              "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/lib/node_modules/npm/bin/npm-cli.js"
            },
            "cli_size": {
              "const": 54
            },
            "cli_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "buildx": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "/opt/openclaw-tools/docker-buildx-v0.13.1"
            },
            "version": {
              "const": "0.13.1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "sha256",
            "host"
          ],
          "properties": {
            "path": {
              "const": "/usr/bin/docker"
            },
            "version": {
              "const": "29.1.3"
            },
            "sha256": {
              "const": "226408f543344f0d2bfc84c7df4243c5364baccf509e8984d04e1e62c74efac0"
            },
            "host": {
              "const": "unix:///run/user/1001/docker.sock"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_path",
        "blob_oid",
        "size",
        "sha256"
      ],
      "properties": {
        "repository_path": {
          "type": "string"
        },
        "blob_oid": {
          "$ref": "#/$defs/gitObjectId"
        },
        "size": {
          "$ref": "#/$defs/positiveSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "installerBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/install-reviewed-task2-launcher.mjs"
            }
          }
        }
      ]
    },
    "launcherBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/launch-reviewed-task2.mjs"
            }
          }
        }
      ]
    },
    "orchestratorBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/run-reviewed-task2.ps1"
            }
          }
        }
      ]
    },
    "sourceGateBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/verify-reviewed-source-gate.mjs"
            }
          }
        }
      ]
    },
    "buildHelperBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/build-reproducible-image.ps1"
            }
          }
        }
      ]
    },
    "evidenceHelperBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/fileBinding"
        },
        {
          "properties": {
            "repository_path": {
              "const": "services/openclaw-zalo-cell/scripts/create-evidence-child.ps1"
            }
          }
        }
      ]
    },
    "reviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "file_name",
        "size",
        "sha256"
      ],
      "properties": {
        "checkpoint": {
          "enum": [
            "M",
            "R"
          ]
        },
        "file_name": {
          "type": "string",
          "pattern": "^[mr]-review-report-v1-[0-9a-f]{40}\\.json$"
        },
        "size": {
          "$ref": "#/$defs/positiveSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mReviewReport": {
      "allOf": [
        {
          "$ref": "#/$defs/reviewReport"
        },
        {
          "properties": {
            "checkpoint": {
              "const": "M"
            },
            "file_name": {
              "pattern": "^m-review-report-v1-[0-9a-f]{40}\\.json$"
            }
          }
        }
      ]
    },
    "rReviewReport": {
      "allOf": [
        {
          "$ref": "#/$defs/reviewReport"
        },
        {
          "properties": {
            "checkpoint": {
              "const": "R"
            },
            "file_name": {
              "pattern": "^r-review-report-v1-[0-9a-f]{40}\\.json$"
            }
          }
        }
      ]
    }
  }
}
