{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.local/schemas/openclaw-zalo-cell-build-evidence-v1.json",
  "title": "OpenClaw Zalo cell reproducible image evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_m",
    "reviewed_tree",
    "reviews",
    "execution_authority",
    "reviewed_export",
    "supply_chain",
    "retained_inputs",
    "source_date_epoch",
    "platform",
    "image_digest",
    "image_lock",
    "base_image",
    "buildx",
    "buildkit",
    "docker",
    "docker_runtime",
    "oci",
    "plugin_probe",
    "runtime_reachability",
    "installed_fork",
    "session_crypto",
    "verification"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "expected_m": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M", "R"],
      "properties": {
        "M": { "$ref": "#/$defs/mReviewRecord" },
        "R": { "$ref": "#/$defs/rReviewRecord" }
      }
    },
    "execution_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_manifest_base64",
        "approval_manifest_size",
        "approval_manifest_sha256",
        "expected_m",
        "reviewed_tree",
        "authorities",
        "runtime"
      ],
      "properties": {
        "approval_manifest_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "approval_manifest_size": { "type": "integer", "minimum": 1 },
        "approval_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expected_m": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "reviewed_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authorities": { "$ref": "#/$defs/task2ExecutionAuthorities" },
        "runtime": { "$ref": "#/$defs/task2ExecutionRuntime" }
      }
    },
    "reviewed_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "manifest_size",
        "reviewed_tree",
        "entry_count",
        "entries_sha256"
      ],
      "properties": {
        "manifest_path": { "type": "string", "pattern": "^.+$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_size": { "type": "integer", "minimum": 1 },
        "reviewed_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "entry_count": { "type": "integer", "minimum": 1 },
        "entries_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "supply_chain": { "$ref": "#/$defs/supplyChain" },
    "retained_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_a",
        "archive_b",
        "stock_oci",
        "upstream_tgz",
        "behavior_runner"
      ],
      "properties": {
        "archive_a": { "$ref": "#/$defs/retainedFileBinding" },
        "archive_b": { "$ref": "#/$defs/retainedFileBinding" },
        "stock_oci": { "$ref": "#/$defs/retainedFileBinding" },
        "upstream_tgz": { "$ref": "#/$defs/retainedFileBinding" },
        "behavior_runner": { "$ref": "#/$defs/retainedFileBinding" }
      }
    },
    "source_date_epoch": { "type": "string", "const": "1785062400" },
    "platform": { "type": "string", "const": "linux/amd64" },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "image_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "algorithm", "context_root_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "const": "services/openclaw-zalo-cell/image-lock.json"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "algorithm": {
          "type": "string",
          "const": "ihome-openclaw-context-root-v2"
        },
        "context_root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "base_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {
          "type": "string",
          "const": "ghcr.io/openclaw/openclaw:2026.7.1@sha256:165b4992f1b4b74ffdd7a02c887ba006f9f5dc951eca420eef573a8b233b543f"
        },
        "digest": {
          "type": "string",
          "const": "sha256:165b4992f1b4b74ffdd7a02c887ba006f9f5dc951eca420eef573a8b233b543f"
        }
      }
    },
    "buildx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "const": "0.13.1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "buildkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "version"],
      "properties": {
        "image": {
          "type": "string",
          "const": "moby/buildkit:v0.13.2@sha256:9194b5ec1be368f41c516df7f93f7f540630ea06136056b2ffebb62226ed4ad6"
        },
        "version": { "type": "string", "const": "v0.13.2" }
      }
    },
    "docker_runtime": { "$ref": "#/$defs/dockerRuntime" },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "network_none", "offline_install", "session_dist_paths"],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["install", "runtime"] }
        },
        "network_none": { "type": "boolean", "const": true },
        "offline_install": { "type": "boolean", "const": true },
        "session_dist_paths": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "pattern": "^session-crypto/dist/.+$" }
        }
      }
    },
    "oci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_a_sha256",
        "archive_b_sha256",
        "byte_identical",
        "promoted_archive_role",
        "promoted_archive_sha256",
        "index_sha256",
        "manifest_digest",
        "config_digest",
        "layer_digests",
        "blob_manifest_sha256",
        "archive_entry_count",
        "archive_entries",
        "runtime_config",
        "rootfs"
      ],
      "properties": {
        "archive_a_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archive_b_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_identical": { "type": "boolean", "const": true },
        "promoted_archive_role": { "type": "string", "const": "A" },
        "promoted_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "layer_digests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "blob_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_entry_count": { "type": "integer" },
        "archive_entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ociArchiveEntry" }
        },
        "runtime_config": { "$ref": "#/$defs/ociRuntimeConfig" },
        "rootfs": { "$ref": "#/$defs/rootfsEvidence" }
      }
    },
    "plugin_probe": { "$ref": "#/$defs/pluginProbe" },
    "runtime_reachability": { "$ref": "#/$defs/runtimeReachability" },
    "session_crypto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "installed", "closure_sha256"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/fileRecord" }
        },
        "installed": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/runtimeRootfsRecord" }
        },
        "closure_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "installed_fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "file_count", "directory_count", "root_sha256"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/installedRecord" }
        },
        "file_count": { "type": "integer" },
        "directory_count": { "type": "integer" },
        "root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_lock",
        "schema",
        "normalized_install",
        "minimal_rootfs",
        "plugin_probe",
        "installed_behavior",
        "runtime_reachability",
        "execution_authority",
        "reviewed_export",
        "supply_chain",
        "rootfs",
        "private_rpc"
      ],
      "properties": {
        "image_lock": { "type": "boolean", "const": true },
        "schema": { "type": "boolean", "const": true },
        "normalized_install": { "type": "boolean", "const": true },
        "minimal_rootfs": { "type": "boolean", "const": true },
        "plugin_probe": { "type": "boolean", "const": true },
        "installed_behavior": { "type": "boolean", "const": true },
        "runtime_reachability": { "type": "boolean", "const": true },
        "execution_authority": { "type": "boolean", "const": true },
        "reviewed_export": { "type": "boolean", "const": true },
        "supply_chain": { "type": "boolean", "const": true },
        "rootfs": { "type": "boolean", "const": true },
        "private_rpc": { "type": "boolean", "const": true }
      }
    }
  },
  "$defs": {
    "task2ExecutionFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "blob_oid", "size", "sha256"],
      "properties": {
        "repository_path": { "type": "string", "pattern": "^services/openclaw-zalo-cell/scripts/.+$" },
        "blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "task2ExecutionAuthorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installer", "launcher", "orchestrator", "source_gate", "build_helper", "evidence_helper"],
      "properties": {
        "installer": { "$ref": "#/$defs/task2ExecutionFileBinding" },
        "launcher": { "$ref": "#/$defs/task2ExecutionFileBinding" },
        "orchestrator": { "$ref": "#/$defs/task2ExecutionFileBinding" },
        "source_gate": { "$ref": "#/$defs/task2ExecutionFileBinding" },
        "build_helper": { "$ref": "#/$defs/task2ExecutionFileBinding" },
        "evidence_helper": { "$ref": "#/$defs/task2ExecutionFileBinding" }
      }
    },
    "task2ExecutionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "git", "powershell", "npm", "buildx", "docker"],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "size", "sha256"],
          "properties": {
            "path": { "type": "string", "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/bin/node" },
            "version": { "type": "string", "const": "v24.15.0" },
            "size": { "type": "integer", "const": 122889056 },
            "sha256": { "type": "string", "const": "d1de76d8edf2fededf6f8b30d244e2c0529ac607923a018283b77e9c74bd932c" }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "sha256"],
          "properties": {
            "path": { "type": "string", "const": "/usr/bin/git" },
            "version": { "type": "string", "const": "git version 2.53.0" },
            "sha256": { "type": "string", "const": "5516c9f362c29376ab9a499a33082f9f611941d8c75930c880e30ad109e39c9a" }
          }
        },
        "powershell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "sha256", "tree_sha256"],
          "properties": {
            "path": { "type": "string", "const": "/opt/openclaw-tools/powershell-7.6.2/pwsh" },
            "version": { "type": "string", "const": "7.6.2" },
            "sha256": { "type": "string", "const": "cd7ac031490349b4ffd203cadf8922af85113b84ab9bfc28a50d03730d9309bc" },
            "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_path", "version", "entry_count", "root_sha256", "cli_path", "cli_size", "cli_sha256"],
          "properties": {
            "root_path": { "type": "string", "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/lib/node_modules/npm" },
            "version": { "type": "string", "const": "11.12.1" },
            "entry_count": { "type": "integer", "const": 2169 },
            "root_sha256": { "type": "string", "const": "aebb5b5b1892a7dd23c04af9b5afa24747f752beff2e4f2e781d9eb3830f93d9" },
            "cli_path": { "type": "string", "const": "/opt/openclaw-tools/node-v24.15.0-linux-x64/lib/node_modules/npm/bin/npm-cli.js" },
            "cli_size": { "type": "integer", "const": 54 },
            "cli_sha256": { "type": "string", "const": "8e5f6f3429f8cdbe693cdc29904e9d5a7b127a494bd15c804bd54c7403bfcbe7" }
          }
        },
        "buildx": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "sha256"],
          "properties": {
            "path": { "type": "string", "const": "/opt/openclaw-tools/docker-buildx-v0.13.1" },
            "version": { "type": "string", "const": "0.13.1" },
            "sha256": { "type": "string", "const": "3e2bc8ed25a9125d6aeec07df4e0211edea6288e075b524160ef3fd305d3d74c" }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "sha256", "host"],
          "properties": {
            "path": { "type": "string", "const": "/usr/bin/docker" },
            "version": { "type": "string", "const": "29.1.3" },
            "sha256": { "type": "string", "const": "40cdaf7fd0f21089dd9e15b0c3a7dd7f2399027f010e366dac6304ae0615954a" },
            "host": { "type": "string", "const": "unix:///run/user/1001/docker.sock" }
          }
        }
      }
    },
    "retainedFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pluginImageProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_sha256",
        "list_size",
        "inspect_sha256",
        "inspect_size",
        "plugin_count",
        "plugin",
        "inspect",
        "discovery_roots"
      ],
      "properties": {
        "list_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "list_size": { "type": "integer" },
        "inspect_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inspect_size": { "type": "integer" },
        "plugin_count": { "type": "integer" },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "version",
            "source",
            "root_dir",
            "origin",
            "enabled",
            "status",
            "channel_ids"
          ],
          "properties": {
            "id": { "type": "string", "const": "zalouser" },
            "name": { "type": "string", "const": "Zalo Personal" },
            "version": { "type": "string", "const": "2026.7.1" },
            "source": { "type": "string", "pattern": "/@openclaw/zalouser/dist/index\\.js$" },
            "root_dir": { "type": "string", "pattern": "/@openclaw/zalouser$" },
            "origin": { "type": "string", "const": "global" },
            "enabled": { "type": "boolean", "const": true },
            "status": { "type": "string", "const": "loaded" },
            "channel_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "type": "string", "const": "zalouser" }
            }
          }
        },
        "inspect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imported",
            "package_name",
            "source",
            "root_dir",
            "install_source",
            "install_spec",
            "install_path",
            "resolved_version"
          ],
          "properties": {
            "imported": { "type": "boolean", "const": true },
            "package_name": { "type": "string", "const": "@openclaw/zalouser" },
            "source": { "type": "string", "pattern": "/@openclaw/zalouser/dist/index\\.js$" },
            "root_dir": { "type": "string", "pattern": "/@openclaw/zalouser$" },
            "install_source": { "type": "string", "const": "npm" },
            "install_spec": { "type": "string", "const": "@openclaw/zalouser@2026.7.1" },
            "install_path": { "type": "string", "pattern": "/@openclaw/zalouser$" },
            "resolved_version": { "type": "string", "const": "2026.7.1" }
          }
        },
        "discovery_roots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^/home/node/\\.openclaw/npm/projects/zalouser" }
        }
      }
    },
    "ociArchiveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(oci-layout|index\\.json|blobs/sha256/[0-9a-f]{64})$" },
        "size": { "type": "integer" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtimeRootfsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "mode", "uid", "gid", "size", "sha256", "mtime"],
      "properties": {
        "path": { "type": "string", "pattern": "^.+$" },
        "type": { "type": "string", "enum": ["file", "directory"] },
        "mode": { "type": "string", "pattern": "^0[67][0-7]{2}$" },
        "uid": { "type": "integer", "enum": [0, 1000] },
        "gid": { "type": "integer", "enum": [0, 1000] },
        "size": { "type": "integer" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mtime": { "type": "integer", "const": 1785062400 }
      }
    },
    "ociRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "user", "entrypoint", "cmd", "env", "working_dir"],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["architecture", "os"],
          "properties": {
            "architecture": { "type": "string", "const": "amd64" },
            "os": { "type": "string", "const": "linux" }
          }
        },
        "user": { "type": "string", "const": "node" },
        "entrypoint": { "type": "array", "const": ["tini", "-s", "--"] },
        "cmd": { "type": "array", "const": ["node", "openclaw.mjs", "gateway"] },
        "env": {
          "type": "array",
          "const": [
            "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "NODE_VERSION=24.16.0",
            "YARN_VERSION=1.22.22",
            "COREPACK_HOME=/usr/local/share/corepack",
            "PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright",
            "NODE_ENV=production"
          ]
        },
        "working_dir": { "type": "string", "const": "/app" }
      }
    },
    "rootfsLayerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "diff_id", "record_count", "records_sha256"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "diff_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "record_count": { "type": "integer" },
        "records_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rootfsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "os",
        "base_layer_count",
        "delta_layer_count",
        "diff_ids",
        "layers",
        "config_path",
        "fork_root",
        "record_count",
        "session_paths",
        "records",
        "records_sha256",
        "fork_records",
        "session_records",
        "config_record"
      ],
      "properties": {
        "architecture": { "type": "string", "const": "amd64" },
        "os": { "type": "string", "const": "linux" },
        "base_layer_count": { "type": "integer" },
        "delta_layer_count": { "type": "integer", "const": 5 },
        "diff_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "layers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/rootfsLayerEvidence" }
        },
        "config_path": { "type": "string", "const": "opt/openclaw-cell/openclaw.json.tmpl" },
        "fork_root": { "type": "string", "const": "home/node/.openclaw/npm/projects/zalouser" },
