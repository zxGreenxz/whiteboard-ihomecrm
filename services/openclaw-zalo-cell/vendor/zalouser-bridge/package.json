{
  "name": "@ihome/openclaw-zalouser-vendor-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "verify:upstream": "node scripts/preflight.mjs && node scripts/verify-upstream.mjs --online",
    "vendor:prepare": "node scripts/preflight.mjs && node scripts/prepare.mjs --tarball .work/verified-upstream.tgz",
    "typecheck": "node scripts/preflight.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/preflight.mjs && vitest run --config vitest.config.ts",
    "build": "node scripts/preflight.mjs && node scripts/build.mjs",
    "pack": "node scripts/preflight.mjs && node scripts/pack.mjs",
    "verify:artifact": "node scripts/preflight.mjs && node scripts/verify-artifact.mjs",
    "verify": "node scripts/preflight.mjs && node scripts/verify-upstream.mjs --online && node scripts/prepare.mjs --tarball .work/verified-upstream.tgz && tsc --noEmit -p tsconfig.json && vitest run --config vitest.config.ts && node scripts/build.mjs && node scripts/pack.mjs && node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "esbuild": "0.25.8",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}
