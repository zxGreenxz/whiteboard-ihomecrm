+      kind: classifyInboundMediaKind(record, providerEventType, mime),
+      mime,
+      byteLength: toNonNegativeInteger(
+        firstProviderValue(record, ["byteLength", "fileSize", "hdSize", "size", "totalSize"]),
+      ),
+      providerChecksum: nullableProviderString(
+        firstProviderValue(record, ["providerChecksum", "checksum", "sha256", "md5"]),
+      ),
+      fetchRef: nullableProviderString(
+        firstProviderValue(
+          record,
+          [
+            "fetchRef",
+            "fileUrl",
+            "downloadUrl",
+            "videoUrl",
+            "voiceUrl",
+            "m4aUrl",
+            "rawUrl",
+            "hdUrl",
+            "normalUrl",
+            "oriUrl",
+            "thumbUrl",
+            "href",
+            "url",
+            "thumb",
+            "thumbnail",
+          ],
+        ),
+      ),
+    };
+  });
+}
