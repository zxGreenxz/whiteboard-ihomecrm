+      const nested = content[key];
+      if (Array.isArray(nested)) nested.forEach(append);
+    }
+    const directEvidenceKeys = [
+      "mediaId",
+      "photoId",
+      "fileId",
+      "stickerId",
+      "mime",
+      "mimeType",
+      "contentType",
+      "byteLength",
+      "fileSize",
+      "hdSize",
+      "checksum",
+      "sha256",
+      "md5",
+      "videoUrl",
+      "voiceUrl",
+      "m4aUrl",
+      "rawUrl",
+      "hdUrl",
+      "normalUrl",
+      "oriUrl",
+      "thumbUrl",
