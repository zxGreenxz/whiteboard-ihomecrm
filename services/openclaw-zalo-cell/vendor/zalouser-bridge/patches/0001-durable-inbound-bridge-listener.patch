+function providerScalarString(value: unknown): string {
+  const direct = toStringValue(value);
+  if (direct) return direct;
+  if (!value || typeof value !== "object") return "";
+  try {
+    const toFixed = (value as { toFixed?: unknown }).toFixed;
+    if (typeof toFixed === "function") {
+      const fixed = Reflect.apply(toFixed, value, []);
+      if (typeof fixed === "string" && fixed.trim()) return fixed.trim();
+    }
+  } catch {
+    // Fall back to JSON serialization for provider scalar wrappers without a usable toFixed.
+  }
+  try {
+    const serialized = JSON.stringify(value);
+    if (serialized === undefined) return "";
+    const parsed = JSON.parse(serialized) as unknown;
+    if (typeof parsed === "string") return parsed.trim();
+    if (typeof parsed === "number" && Number.isFinite(parsed)) return String(Math.trunc(parsed));
+  } catch {
+    return "";
+  }
+  return "";
+}
+
+function nullableProviderString(value: unknown): string | null {
+  return providerScalarString(value) || null;
+}
+
+function snapshotProviderEnvelope(value: unknown): unknown {
+  const serialized = JSON.stringify(value);
+  if (serialized === undefined) {
+    throw new TypeError("provider envelope is not JSON serializable");
+  }
