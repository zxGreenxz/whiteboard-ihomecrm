+function classifyInboundEventKind(
+  providerEventType: string,
+): ZaloInboundMessage["bridge"]["eventKind"] {
+  const normalized = providerEventType.toLowerCase();
+  if (normalized.includes("reaction")) return "REACTION";
+  if (normalized.includes("deliver")) return "DELIVERY_RECEIPT";
+  if (normalized.includes("seen") || normalized.includes("read")) return "SEEN";
+  if (normalized.includes("typing")) return "TYPING";
+  if (/member|join|leave/u.test(normalized)) return "MEMBERSHIP";
+  if (/message|webchat|text|photo|image|video|audio|voice|file|sticker|link/u.test(normalized)) {
+    return "MESSAGE";
+  }
+  return "OTHER";
+}
+
+function classifyInboundMediaKind(
+  record: Record<string, unknown>,
+  providerEventType: string,
+  mime: string | null,
+): ZaloInboundMessage["bridge"]["normalized"]["media"][number]["kind"] {
+  const hint = [
+    providerEventType,
+    toStringValue(record.kind),
+    toStringValue(record.type),
+    toStringValue(record.mediaType),
+    mime ?? "",
+  ].join(" ").toLowerCase();
+  if (hint.includes("sticker")) return "STICKER";
+  if (/image|photo/u.test(hint)) return "IMAGE";
+  if (hint.includes("video")) return "VIDEO";
+  if (/audio|voice/u.test(hint)) return "AUDIO";
+  if (/file|document|attachment/u.test(hint)) return "FILE";
+  return "OTHER";
+}
+
+function extractInboundMediaInputs(
+  rawContent: unknown,
+  providerEventType: string,
+): ZaloInboundMessage["bridge"]["normalized"]["media"] {
+  const records: Record<string, unknown>[] = [];
+  const append = (value: unknown) => {
+    if (value && typeof value === "object" && !Array.isArray(value)) {
+      records.push(value as Record<string, unknown>);
+    }
+  };
+  if (Array.isArray(rawContent)) {
+    rawContent.forEach(append);
+  } else if (rawContent && typeof rawContent === "object") {
+    const content = rawContent as Record<string, unknown>;
