+
+export function installZaloBehaviorProbeProviderV1(
+  profileInput: string,
+  api: BehaviorProbeZaloApiV1,
+): () => void {
+  if (process.env.IHOME_BEHAVIOR_PROBE !== "1") {
+    throw Object.assign(new Error("behavior probe provider is disabled"), {
+      code: "BEHAVIOR_PROBE_DISABLED",
+    });
+  }
+  const profile = normalizeProfile(profileInput);
+  if (!api || typeof api !== "object") {
+    throw Object.assign(new Error("behavior probe provider is invalid"), {
+      code: "BEHAVIOR_PROBE_PROVIDER_INVALID",
+    });
+  }
+  for (const method of ["getContext", "getCookie", "sendMessage", "uploadAttachment", "sendVoice", "sendTypingEvent"]) {
+    if (typeof (api as Record<string, unknown>)[method] !== "function") {
+      throw Object.assign(new Error(`behavior probe provider is missing ${method}`), {
+        code: "BEHAVIOR_PROBE_PROVIDER_INVALID",
+      });
+    }
+  }
+  if (apiByProfile.has(profile) || apiInitByProfile.has(profile)) {
+    throw Object.assign(new Error(`behavior probe profile is already occupied: ${profile}`), {
+      code: "BEHAVIOR_PROBE_PROFILE_OCCUPIED",
+    });
+  }
+  apiByProfile.set(profile, api as API);
+  let active = true;
+  return () => {
+    if (!active) return;
+    active = false;
+    if (apiByProfile.get(profile) === api) apiByProfile.delete(profile);
+  };
+}
