# Chỉ là tên biến/mẫu giả. Nạp secret bằng secret manager ở môi trường chạy.
APP_ORIGIN=https://app.example.test
BANK_EMAIL_PUBLIC_URL=https://bank-email.example.test
BANK_EMAIL_PORT=8080
BANK_EMAIL_BIND_HOST=127.0.0.1

SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=publishable-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=service-role-key-placeholder

GOOGLE_OAUTH_CLIENT_ID=client-id-placeholder.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=client-secret-placeholder
GOOGLE_OAUTH_REDIRECT_URI=https://bank-email.example.test/oauth/callback
GOOGLE_PUBSUB_TOPIC=projects/example-project/topics/gmail-acb
GOOGLE_PUBSUB_AUDIENCE=https://bank-email.example.test/pubsub
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=push-auth@example-project.iam.gserviceaccount.com

# Base64 của đúng 32 byte ngẫu nhiên; không đổi khi còn token được mã hóa.
BANK_EMAIL_TOKEN_KEY_BASE64=base64-32-byte-key-placeholder
