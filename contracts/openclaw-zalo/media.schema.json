{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/media.schema.json",
  "title": "OpenClaw signed media gateway ticket contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "frozenMaintenanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintenancePrincipalId",
        "credentialGeneration",
        "leaseGeneration",
        "fencingToken",
        "claimGeneration"
      ],
      "properties": {
        "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
        "credentialGeneration": { "type": "integer", "minimum": 1 },
        "leaseGeneration": { "type": "integer", "minimum": 1 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "claimGeneration": { "type": "integer", "minimum": 1 }
      }
    },
    "ticketBase": {
      "type": "object",
      "required": [
        "version",
        "aud",
        "operation",
        "subject",
        "jti",
        "organizationId",
        "accountId",
        "objectKey",
        "sha256",
        "contentType",
        "contentLength",
        "sessionGeneration",
        "gatewayKeyGeneration",
        "iat",
        "exp",
        "signature"
      ],
      "properties": {
        "version": { "const": 1 },
        "aud": { "const": "openclaw-media-gateway" },
        "operation": { "enum": ["PUT", "GET", "DELETE", "ANCHOR", "ANCHOR_VERIFY"] },
        "subject": { "enum": ["BROWSER", "RUNTIME", "MAINTENANCE"] },
        "jti": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "objectKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "contentType": { "type": "string", "minLength": 3, "maxLength": 255 },
        "contentLength": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "sessionGeneration": { "type": "integer", "minimum": 0 },
        "gatewayKeyGeneration": { "type": "integer", "minimum": 1 },
        "iat": { "type": "integer" },
        "exp": { "type": "integer" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "browserGetTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "browserUserId",
            "browserSessionIdSha256",
            "browserAccessTokenSha256"
          ],
          "properties": {
            "operation": { "const": "GET" },
            "subject": { "const": "BROWSER" },
            "accountId": { "$ref": "#/$defs/uuid" },
            "browserUserId": { "$ref": "#/$defs/uuid" },
            "browserSessionIdSha256": { "$ref": "#/$defs/sha256" },
            "browserAccessTokenSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runtimeTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "cellId",
            "credentialGeneration",
            "leaseGeneration",
            "fencingToken",
            "receiptSigningKeyGeneration"
          ],
          "properties": {
            "operation": { "enum": ["PUT", "GET"] },
            "subject": { "const": "RUNTIME" },
            "accountId": { "$ref": "#/$defs/uuid" },
            "sessionGeneration": { "type": "integer", "minimum": 1 },
            "cellId": { "$ref": "#/$defs/uuid" },
            "credentialGeneration": { "type": "integer", "minimum": 1 },
            "leaseGeneration": { "type": "integer", "minimum": 1 },
            "fencingToken": { "type": "integer", "minimum": 1 },
            "receiptSigningKeyGeneration": { "type": "integer", "minimum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "maintenanceDeleteTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "maintenancePrincipalId",
            "workItemId",
            "claimGeneration",
            "credentialGeneration",
            "leaseGeneration",
            "fencingToken",
            "receiptSigningKeyGeneration",
            "deletePhase",
            "quarantineVersion",
            "finalDeleteNotBefore",
            "holdVersion"
          ],
          "properties": {
            "operation": { "const": "DELETE" },
            "subject": { "const": "MAINTENANCE" },
            "accountId": { "type": "null" },
            "sessionGeneration": { "const": 0 },
            "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
            "workItemId": { "$ref": "#/$defs/uuid" },
            "claimGeneration": { "type": "integer", "minimum": 1 },
            "credentialGeneration": { "type": "integer", "minimum": 1 },
            "leaseGeneration": { "type": "integer", "minimum": 1 },
            "fencingToken": { "type": "integer", "minimum": 1 },
            "receiptSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "deletePhase": { "const": "FINAL_DELETE" },
            "quarantineVersion": { "type": "integer", "minimum": 1 },
            "finalDeleteNotBefore": { "type": "integer" },
            "holdVersion": { "type": "integer", "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "maintenanceAuditTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "maintenancePrincipalId",
            "workItemId",
            "claimGeneration",
            "credentialGeneration",
            "leaseGeneration",
            "fencingToken",
            "receiptSigningKeyGeneration",
            "auditRootId",
            "rootHash",
            "signatureHash",
            "auditSigningKeyGeneration",
            "auditSigningPublicKeyHash"
          ],
          "properties": {
            "operation": { "enum": ["ANCHOR", "ANCHOR_VERIFY"] },
            "subject": { "const": "MAINTENANCE" },
            "accountId": { "type": "null" },
            "contentType": { "const": "application/json" },
            "sessionGeneration": { "const": 0 },
            "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
            "workItemId": { "$ref": "#/$defs/uuid" },
            "claimGeneration": { "type": "integer", "minimum": 1 },
            "credentialGeneration": { "type": "integer", "minimum": 1 },
            "leaseGeneration": { "type": "integer", "minimum": 1 },
            "fencingToken": { "type": "integer", "minimum": 1 },
            "receiptSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "auditRootId": { "$ref": "#/$defs/uuid" },
            "rootHash": { "$ref": "#/$defs/sha256" },
            "signatureHash": { "$ref": "#/$defs/sha256" },
            "auditSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "auditSigningPublicKeyHash": { "$ref": "#/$defs/sha256" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "retentionRecoveryTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "maintenancePrincipalId",
            "workItemId",
            "credentialGeneration",
            "leaseGeneration",
            "fencingToken",
            "receiptSigningKeyGeneration",
            "recoveryKind",
            "recoveryGeneration",
            "replacesTicketJti",
            "replacesDeleteAuthorizationJti",
            "frozenClaim",
            "deletePhase",
            "quarantineVersion",
            "finalDeleteNotBefore",
            "holdVersion"
          ],
          "properties": {
            "operation": { "const": "DELETE" },
            "subject": { "const": "MAINTENANCE" },
            "accountId": { "type": "null" },
            "sessionGeneration": { "const": 0 },
            "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
            "workItemId": { "$ref": "#/$defs/uuid" },
            "credentialGeneration": { "type": "integer", "minimum": 1 },
            "leaseGeneration": { "type": "integer", "minimum": 1 },
            "fencingToken": { "type": "integer", "minimum": 1 },
            "receiptSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "recoveryKind": { "const": "RETENTION_DELETE_AUTHORIZED" },
            "recoveryGeneration": { "type": "integer", "minimum": 1 },
            "replacesTicketJti": { "$ref": "#/$defs/uuid" },
            "replacesDeleteAuthorizationJti": { "$ref": "#/$defs/uuid" },
            "frozenClaim": { "$ref": "#/$defs/frozenMaintenanceClaim" },
            "deletePhase": { "const": "FINAL_DELETE" },
            "quarantineVersion": { "type": "integer", "minimum": 1 },
            "finalDeleteNotBefore": { "type": "integer" },
            "holdVersion": { "type": "integer", "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "auditRecoveryTicket": {
      "allOf": [
        { "$ref": "#/$defs/ticketBase" },
        {
          "type": "object",
          "required": [
            "maintenancePrincipalId",
            "workItemId",
            "credentialGeneration",
            "leaseGeneration",
            "fencingToken",
            "receiptSigningKeyGeneration",
            "recoveryKind",
            "recoveryGeneration",
            "replacesVerifyTicketJti",
            "frozenClaim",
            "auditRootId",
            "rootHash",
            "signatureHash",
            "auditSigningKeyGeneration",
            "auditSigningPublicKeyHash"
          ],
          "properties": {
            "operation": { "const": "ANCHOR_VERIFY" },
            "subject": { "const": "MAINTENANCE" },
            "accountId": { "type": "null" },
            "contentType": { "const": "application/json" },
            "sessionGeneration": { "const": 0 },
            "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
            "workItemId": { "$ref": "#/$defs/uuid" },
            "credentialGeneration": { "type": "integer", "minimum": 1 },
            "leaseGeneration": { "type": "integer", "minimum": 1 },
            "fencingToken": { "type": "integer", "minimum": 1 },
            "receiptSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "recoveryKind": { "const": "AUDIT_VERIFY_AUTHORIZED" },
            "recoveryGeneration": { "type": "integer", "minimum": 1 },
            "replacesVerifyTicketJti": { "$ref": "#/$defs/uuid" },
            "frozenClaim": { "$ref": "#/$defs/frozenMaintenanceClaim" },
            "auditRootId": { "$ref": "#/$defs/uuid" },
            "rootHash": { "$ref": "#/$defs/sha256" },
            "signatureHash": { "$ref": "#/$defs/sha256" },
            "auditSigningKeyGeneration": { "type": "integer", "minimum": 1 },
            "auditSigningPublicKeyHash": { "$ref": "#/$defs/sha256" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/browserGetTicket" },
    { "$ref": "#/$defs/runtimeTicket" },
    { "$ref": "#/$defs/maintenanceDeleteTicket" },
    { "$ref": "#/$defs/maintenanceAuditTicket" },
    { "$ref": "#/$defs/retentionRecoveryTicket" },
    { "$ref": "#/$defs/auditRecoveryTicket" }
  ],
  "unevaluatedProperties": false
}
