{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/runtime.schema.json",
  "title": "OpenClaw runtime and delivery contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": { "type": "integer", "minimum": 1 },
    "sendPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "partIndex", "kind", "text"],
          "properties": {
            "version": { "const": 1 },
            "partIndex": { "type": "integer", "minimum": 0, "maximum": 19 },
            "kind": { "const": "TEXT" },
            "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "partIndex",
            "kind",
            "objectKey",
            "sha256",
            "mime",
            "bytes"
          ],
          "properties": {
            "version": { "const": 1 },
            "partIndex": { "type": "integer", "minimum": 0, "maximum": 19 },
            "kind": { "const": "MEDIA" },
            "objectKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "mime": { "type": "string", "minLength": 3, "maxLength": 255 },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 }
          }
        }
      ]
    },
    "frozenInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignVersionId",
        "scheduleVersion",
        "subscriptionVersion",
        "subscriptionId",
        "occurrenceId",
        "sourceTable",
        "sourceId",
        "sourceVersion",
        "knowledgeVersionIds",
        "sourceSnapshotHash",
        "targetVersion",
        "targetDirectoryRefreshedAt",
        "fieldMappingHash"
      ],
      "properties": {
        "campaignVersionId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "scheduleVersion": {
          "oneOf": [{ "$ref": "#/$defs/positiveVersion" }, { "type": "null" }]
        },
        "subscriptionVersion": {
          "oneOf": [{ "$ref": "#/$defs/positiveVersion" }, { "type": "null" }]
        },
        "subscriptionId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "occurrenceId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "sourceTable": { "type": ["string", "null"], "maxLength": 128 },
        "sourceId": { "type": ["string", "null"], "maxLength": 256 },
        "sourceVersion": { "type": ["string", "null"], "maxLength": 256 },
        "knowledgeVersionIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "sourceSnapshotHash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "targetVersion": { "$ref": "#/$defs/positiveVersion" },
        "targetDirectoryRefreshedAt": { "type": "string", "format": "date-time" },
        "fieldMappingHash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "canonicalSendPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organizationId",
        "accountId",
        "target",
        "channel",
        "accountProfile",
        "idempotencyKey",
        "parts",
        "replyToProviderMessageId",
        "policyVersionId",
        "automationVersionId",
        "templateVersionId",
        "frozenInputs"
      ],
      "properties": {
        "version": { "const": 1 },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "providerId"],
          "properties": {
            "kind": { "enum": ["PEER", "SALES_GROUP"] },
            "providerId": { "type": "string", "minLength": 1, "maxLength": 255 }
          }
        },
        "channel": { "const": "zalouser" },
        "accountProfile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 255 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 0 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 1 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 2 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 3 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 4 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 5 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 6 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 7 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 8 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 9 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 10 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 11 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 12 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 13 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 14 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 15 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 16 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 17 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 18 } } }] },
            { "allOf": [{ "$ref": "#/$defs/sendPart" }, { "properties": { "partIndex": { "const": 19 } } }] }
          ],
          "items": false
        },
        "replyToProviderMessageId": { "type": ["string", "null"], "maxLength": 255 },
        "policyVersionId": { "$ref": "#/$defs/uuid" },
        "automationVersionId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "templateVersionId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "frozenInputs": { "$ref": "#/$defs/frozenInputs" }
      }
    },
    "authorizationMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outboxId",
        "claimGeneration",
        "payloadHash",
        "fencingToken",
        "sessionGeneration",
        "controlVersion",
        "takeoverVersion",
        "markerNonce",
        "expiresAt"
      ],
      "properties": {
        "version": { "const": 1 },
        "outboxId": { "$ref": "#/$defs/uuid" },
        "claimGeneration": { "$ref": "#/$defs/positiveVersion" },
        "payloadHash": { "$ref": "#/$defs/sha256" },
        "fencingToken": { "$ref": "#/$defs/positiveVersion" },
        "sessionGeneration": { "type": "integer", "minimum": 0 },
        "controlVersion": { "$ref": "#/$defs/positiveVersion" },
        "takeoverVersion": { "type": "integer", "minimum": 0 },
        "markerNonce": { "type": "string", "minLength": 16, "maxLength": 256 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "authorizeSend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "claimToken", "authorizationMarker"],
      "properties": {
        "version": { "const": 1 },
        "claimToken": { "type": "string", "minLength": 32, "maxLength": 512 },
        "authorizationMarker": { "$ref": "#/$defs/authorizationMarker" }
      }
    },
    "outboxClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outboxId",
        "organizationId",
        "accountId",
        "claimToken",
        "claimGeneration",
        "fencingToken",
        "sessionGeneration",
        "controlVersion",
        "takeoverVersion",
        "leaseExpiresAt",
        "payloadHash",
        "payload"
      ],
      "properties": {
        "version": { "const": 1 },
        "outboxId": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "claimToken": { "type": "string", "minLength": 32, "maxLength": 512 },
        "claimGeneration": { "$ref": "#/$defs/positiveVersion" },
        "fencingToken": { "$ref": "#/$defs/positiveVersion" },
        "sessionGeneration": { "type": "integer", "minimum": 0 },
        "controlVersion": { "$ref": "#/$defs/positiveVersion" },
        "takeoverVersion": { "type": "integer", "minimum": 0 },
        "leaseExpiresAt": { "type": "string", "format": "date-time" },
        "payloadHash": { "$ref": "#/$defs/sha256" },
        "payload": { "$ref": "#/$defs/canonicalSendPayload" }
      }
    },
    "deliveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "evidenceKind",
        "outboxId",
        "claimGeneration",
        "payloadHash",
        "authorizationMarker",
        "totalPartCount",
        "knownProviderMessageIds",
        "possibleHandoffPrefixLength",
        "outcome",
        "reasonCode"
      ],
      "properties": {
        "version": { "const": 1 },
        "evidenceKind": { "const": "OUTBOX_DELIVERY" },
        "outboxId": { "$ref": "#/$defs/uuid" },
        "claimGeneration": { "$ref": "#/$defs/positiveVersion" },
        "payloadHash": { "$ref": "#/$defs/sha256" },
        "authorizationMarker": { "$ref": "#/$defs/authorizationMarker" },
        "totalPartCount": { "type": "integer", "minimum": 1, "maximum": 20 },
        "knownProviderMessageIds": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "possibleHandoffPrefixLength": { "type": "integer", "minimum": 0, "maximum": 20 },
        "outcome": { "enum": ["SENT", "FAILED", "UNKNOWN"] },
        "reasonCode": {
          "enum": [
            "ALL_PARTS_ACKNOWLEDGED",
            "PROVIDER_REJECTED_BEFORE_ACCEPT",
            "PROVIDER_TIMEOUT_AFTER_POSSIBLE_HANDOFF",
            "PROVIDER_DISCONNECT_AFTER_POSSIBLE_HANDOFF",
            "ACK_LOST_AFTER_HANDOFF"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "SENT" } }
          },
          "then": {
            "properties": {
              "reasonCode": { "const": "ALL_PARTS_ACKNOWLEDGED" },
              "knownProviderMessageIds": { "minItems": 1 },
              "possibleHandoffPrefixLength": { "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "FAILED" } }
          },
          "then": {
            "properties": {
              "reasonCode": { "const": "PROVIDER_REJECTED_BEFORE_ACCEPT" },
              "knownProviderMessageIds": { "maxItems": 0 },
              "possibleHandoffPrefixLength": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "UNKNOWN" } }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "PROVIDER_TIMEOUT_AFTER_POSSIBLE_HANDOFF",
                  "PROVIDER_DISCONNECT_AFTER_POSSIBLE_HANDOFF",
                  "ACK_LOST_AFTER_HANDOFF"
                ]
              },
              "possibleHandoffPrefixLength": { "minimum": 1 }
            }
          }
        }
      ]
    },
    "outboxCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authorization",
        "deliveryEvidence",
        "deliveryEvidenceHash",
        "outcome",
        "reasonCode"
      ],
      "properties": {
        "version": { "const": 1 },
        "authorization": { "$ref": "#/$defs/authorizeSend" },
        "deliveryEvidence": { "$ref": "#/$defs/deliveryEvidence" },
        "deliveryEvidenceHash": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["SENT", "FAILED", "UNKNOWN"] },
        "reasonCode": {
          "enum": [
            "ALL_PARTS_ACKNOWLEDGED",
            "PROVIDER_REJECTED_BEFORE_ACCEPT",
            "PROVIDER_TIMEOUT_AFTER_POSSIBLE_HANDOFF",
            "PROVIDER_DISCONNECT_AFTER_POSSIBLE_HANDOFF",
            "ACK_LOST_AFTER_HANDOFF"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "SENT" } }
          },
          "then": {
            "properties": {
              "reasonCode": { "const": "ALL_PARTS_ACKNOWLEDGED" },
              "deliveryEvidence": {
                "properties": {
                  "outcome": { "const": "SENT" },
                  "reasonCode": { "const": "ALL_PARTS_ACKNOWLEDGED" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "FAILED" } }
          },
          "then": {
            "properties": {
              "reasonCode": { "const": "PROVIDER_REJECTED_BEFORE_ACCEPT" },
              "deliveryEvidence": {
                "properties": {
                  "outcome": { "const": "FAILED" },
                  "reasonCode": { "const": "PROVIDER_REJECTED_BEFORE_ACCEPT" }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "UNKNOWN" } }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "PROVIDER_TIMEOUT_AFTER_POSSIBLE_HANDOFF",
                  "PROVIDER_DISCONNECT_AFTER_POSSIBLE_HANDOFF",
                  "ACK_LOST_AFTER_HANDOFF"
                ]
              },
              "deliveryEvidence": {
                "properties": { "outcome": { "const": "UNKNOWN" } }
              }
            }
          }
        }
      ]
    },
    "preHandoffRequeue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authorization",
        "outcome",
        "reasonCode",
        "preHandoffEvidence",
        "preHandoffEvidenceHash",
        "retryNotBefore"
      ],
      "properties": {
        "version": { "const": 1 },
        "authorization": { "$ref": "#/$defs/authorizeSend" },
        "outcome": { "const": "SAFE_RETRY" },
        "reasonCode": {
          "enum": [
            "AUTHORIZATION_EXPIRED",
            "LEASE_EXPIRED",
            "CELL_FENCED",
            "SESSION_GENERATION_CHANGED",
            "CONTROL_VERSION_CHANGED",
            "TAKEOVER_VERSION_CHANGED",
            "POLICY_CHANGED_BEFORE_HANDOFF",
            "ADAPTER_NOT_READY",
            "EGRESS_BLOCKED_BEFORE_HANDOFF"
          ]
        },
        "preHandoffEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "evidenceKind",
            "outboxId",
            "claimGeneration",
            "payloadHash",
            "authorizationMarker",
            "reasonCode",
            "authorizedHandoffRecorded"
          ],
          "properties": {
            "version": { "const": 1 },
            "evidenceKind": { "const": "OUTBOX_PRE_HANDOFF" },
            "outboxId": { "$ref": "#/$defs/uuid" },
            "claimGeneration": { "$ref": "#/$defs/positiveVersion" },
            "payloadHash": { "$ref": "#/$defs/sha256" },
            "authorizationMarker": { "$ref": "#/$defs/authorizationMarker" },
            "reasonCode": { "type": "string", "minLength": 1 },
            "authorizedHandoffRecorded": { "const": false }
          }
        },
        "preHandoffEvidenceHash": { "$ref": "#/$defs/sha256" },
        "retryNotBefore": { "type": "string", "format": "date-time" }
      }
    },
    "unknownResolutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outboxId",
        "expectedResolutionVersion",
        "expectedEvidenceDomain",
        "expectedEvidenceHash",
        "outcome",
        "reasonCode",
        "operatorEvidenceHash"
      ],
      "properties": {
        "version": { "const": 1 },
        "outboxId": { "$ref": "#/$defs/uuid" },
        "expectedResolutionVersion": { "const": 0 },
        "expectedEvidenceDomain": { "const": "ihome-openclaw-unknown-authority-v1\u0000" },
        "expectedEvidenceHash": { "$ref": "#/$defs/sha256" },
        "outcome": {
          "enum": ["CONFIRMED_SENT", "CONFIRMED_FAILED", "NEW_INTENT_CREATED"]
        },
        "reasonCode": {
          "enum": [
            "OPERATOR_CONFIRMED_SENT",
            "OPERATOR_CONFIRMED_FAILED",
            "OPERATOR_CREATED_NEW_INTENT"
          ]
        },
        "operatorEvidenceHash": { "$ref": "#/$defs/sha256" },
        "newIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clientOperationId",
            "targetId",
            "sourceDraftId",
            "expectedDraftVersion",
            "replyToMessageId"
          ],
          "properties": {
            "clientOperationId": { "$ref": "#/$defs/uuid" },
            "targetId": { "$ref": "#/$defs/uuid" },
            "sourceDraftId": { "$ref": "#/$defs/uuid" },
            "expectedDraftVersion": { "$ref": "#/$defs/positiveVersion" },
            "replyToMessageId": {
              "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": { "const": "CONFIRMED_SENT" },
            "reasonCode": { "const": "OPERATOR_CONFIRMED_SENT" }
          },
          "not": { "required": ["newIntent"] }
        },
        {
          "properties": {
            "outcome": { "const": "CONFIRMED_FAILED" },
            "reasonCode": { "const": "OPERATOR_CONFIRMED_FAILED" }
          },
          "not": { "required": ["newIntent"] }
        },
        {
          "required": ["newIntent"],
          "properties": {
            "outcome": { "const": "NEW_INTENT_CREATED" },
            "reasonCode": { "const": "OPERATOR_CREATED_NEW_INTENT" }
          }
        }
      ]
    },
    "unknownResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "resolutionId",
        "organizationId",
        "accountId",
        "outboxId",
        "resolutionVersion",
        "outcome",
        "newOutboxId",
        "authoritativeEvidenceDomain",
        "authoritativeEvidenceHash",
        "reasonCode",
        "resolvedBy",
        "resolvedAt"
      ],
      "properties": {
        "version": { "const": 1 },
        "resolutionId": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "outboxId": { "$ref": "#/$defs/uuid" },
        "resolutionVersion": { "const": 1 },
        "outcome": {
          "enum": ["CONFIRMED_SENT", "CONFIRMED_FAILED", "NEW_INTENT_CREATED"]
        },
        "newOutboxId": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "authoritativeEvidenceDomain": {
          "const": "ihome-openclaw-unknown-authority-v1\u0000"
        },
        "authoritativeEvidenceHash": { "$ref": "#/$defs/sha256" },
        "reasonCode": {
          "enum": [
            "OPERATOR_CONFIRMED_SENT",
            "OPERATOR_CONFIRMED_FAILED",
            "OPERATOR_CREATED_NEW_INTENT"
          ]
        },
        "resolvedBy": { "$ref": "#/$defs/uuid" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": { "const": "CONFIRMED_SENT" },
            "reasonCode": { "const": "OPERATOR_CONFIRMED_SENT" },
            "newOutboxId": { "const": null }
          }
        },
        {
          "properties": {
            "outcome": { "const": "CONFIRMED_FAILED" },
            "reasonCode": { "const": "OPERATOR_CONFIRMED_FAILED" },
            "newOutboxId": { "const": null }
          }
        },
        {
          "properties": {
            "outcome": { "const": "NEW_INTENT_CREATED" },
            "reasonCode": { "const": "OPERATOR_CREATED_NEW_INTENT" },
            "newOutboxId": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/canonicalSendPayload" },
    { "$ref": "#/$defs/outboxClaim" },
    { "$ref": "#/$defs/authorizationMarker" },
    { "$ref": "#/$defs/authorizeSend" },
    { "$ref": "#/$defs/outboxCompletion" },
    { "$ref": "#/$defs/preHandoffRequeue" },
    { "$ref": "#/$defs/unknownResolutionRequest" },
    { "$ref": "#/$defs/unknownResolution" }
  ],
  "unevaluatedProperties": false
}
