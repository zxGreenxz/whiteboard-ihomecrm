{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/control.schema.json",
  "title": "OpenClaw control-plane contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimePrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "principalKind",
        "organizationId",
        "accountId",
        "cellId",
        "credentialGeneration",
        "leaseGeneration",
        "fencingToken",
        "sessionGeneration"
      ],
      "properties": {
        "version": { "const": 1 },
        "principalKind": { "const": "CHANNEL" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "cellId": { "$ref": "#/$defs/uuid" },
        "credentialGeneration": { "type": "integer", "minimum": 1 },
        "leaseGeneration": { "type": "integer", "minimum": 1 },
        "fencingToken": { "type": "integer", "minimum": 1 },
        "sessionGeneration": { "type": "integer", "minimum": 0 }
      }
    },
    "maintenancePrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "principalKind",
        "organizationId",
        "maintenancePrincipalId",
        "credentialGeneration",
        "leaseGeneration",
        "fencingToken"
      ],
      "properties": {
        "version": { "const": 1 },
        "principalKind": { "const": "MAINTENANCE" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "maintenancePrincipalId": { "$ref": "#/$defs/uuid" },
        "credentialGeneration": { "type": "integer", "minimum": 1 },
        "leaseGeneration": { "type": "integer", "minimum": 1 },
        "fencingToken": { "type": "integer", "minimum": 1 }
      }
    },
    "runtimeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "audience",
        "operation",
        "issuedAt",
        "nonce",
        "bodyHash"
      ],
      "properties": {
        "version": { "const": 1 },
        "audience": {
          "enum": [
            "openclaw-control",
            "openclaw-runtime",
            "openclaw-qr",
            "openclaw-object-tickets",
            "openclaw-watchdog"
          ]
        },
        "operation": {
          "enum": [
            "CONTROL_READ",
            "CONTROL_WRITE",
            "QR_CREATE",
            "QR_CONSUME",
            "INBOUND_INGEST",
            "OUTBOX_CLAIM",
            "OUTBOX_PREFLIGHT",
            "OUTBOX_AUTHORIZE_SEND",
            "OUTBOX_COMPLETE",
            "OUTBOX_REQUEUE_PRE_HANDOFF",
            "SEND_WORK_CLAIM",
            "SEND_WORK_COMPLETE",
            "MAINTENANCE_WORK_CLAIM",
            "MAINTENANCE_WORK_COMPLETE",
            "MEDIA_TICKET_ISSUE",
            "AUDIT_ANCHOR",
            "RETENTION_DELETE"
          ]
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
        "bodyHash": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        {
          "properties": {
            "audience": { "const": "openclaw-control" },
            "operation": { "enum": ["CONTROL_READ", "CONTROL_WRITE"] }
          }
        },
        {
          "properties": {
            "audience": { "const": "openclaw-qr" },
            "operation": { "enum": ["QR_CREATE", "QR_CONSUME"] }
          }
        },
        {
          "properties": {
            "audience": { "const": "openclaw-object-tickets" },
            "operation": { "const": "MEDIA_TICKET_ISSUE" }
          }
        },
        {
          "properties": {
            "audience": { "const": "openclaw-runtime" },
            "operation": {
              "enum": [
                "INBOUND_INGEST",
                "OUTBOX_CLAIM",
                "OUTBOX_PREFLIGHT",
                "OUTBOX_AUTHORIZE_SEND",
                "OUTBOX_COMPLETE",
                "OUTBOX_REQUEUE_PRE_HANDOFF",
                "SEND_WORK_CLAIM",
                "SEND_WORK_COMPLETE",
                "MAINTENANCE_WORK_CLAIM",
                "MAINTENANCE_WORK_COMPLETE",
                "AUDIT_ANCHOR",
                "RETENTION_DELETE"
              ]
            }
          }
        },
        {
          "properties": {
            "audience": { "const": "openclaw-watchdog" },
            "operation": { "const": "CONTROL_READ" }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/runtimePrincipal" },
    { "$ref": "#/$defs/maintenancePrincipal" },
    { "$ref": "#/$defs/runtimeEnvelope" }
  ],
  "unevaluatedProperties": false
}
