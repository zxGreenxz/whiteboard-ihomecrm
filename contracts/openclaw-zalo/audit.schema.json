{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/audit.schema.json",
  "title": "OpenClaw audit event and root contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditEventProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "auditEventId",
        "organizationId",
        "sequence",
        "occurredAt",
        "eventKind",
        "actorKind",
        "actorId",
        "subjectKind",
        "subjectId",
        "evidenceHash",
        "previousEventHash",
        "eventHash"
      ],
      "properties": {
        "version": { "const": 1 },
        "auditEventId": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "eventKind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
        "actorKind": { "enum": ["USER", "CHANNEL", "MAINTENANCE", "SYSTEM"] },
        "actorId": { "type": ["string", "null"], "maxLength": 255 },
        "subjectKind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" },
        "subjectId": { "type": ["string", "null"], "maxLength": 255 },
        "evidenceHash": { "$ref": "#/$defs/sha256" },
        "previousEventHash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "eventHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "auditRootUnsigned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organizationId",
        "rootDate",
        "firstSequence",
        "lastSequence",
        "eventCount",
        "previousRootHash",
        "merkleRootHash",
        "rootHash",
        "auditSigningKeyGeneration"
      ],
      "properties": {
        "version": { "const": 1 },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "rootDate": { "type": "string", "format": "date" },
        "firstSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "lastSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "eventCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previousRootHash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "merkleRootHash": { "$ref": "#/$defs/sha256" },
        "rootHash": { "$ref": "#/$defs/sha256" },
        "auditSigningKeyGeneration": { "type": "integer", "minimum": 1 }
      }
    },
    "auditRootSignatureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "signingDomain",
        "root",
        "canonicalRootJson",
        "signature",
        "signatureHash"
      ],
      "properties": {
        "version": { "const": 1 },
        "signingDomain": { "const": "ihome-openclaw-audit-root-v1\u0000" },
        "root": { "$ref": "#/$defs/auditRootUnsigned" },
        "canonicalRootJson": { "type": "string", "minLength": 2 },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "signatureHash": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/auditEventProjection" },
    { "$ref": "#/$defs/auditRootUnsigned" },
    { "$ref": "#/$defs/auditRootSignatureEvidence" }
  ],
  "unevaluatedProperties": false
}
