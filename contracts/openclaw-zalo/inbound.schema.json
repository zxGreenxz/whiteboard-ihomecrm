{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/inbound.schema.json",
  "title": "OpenClaw QR and inbound-event contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qrChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "challengeId",
        "organizationId",
        "accountId",
        "cellId",
        "runtimeCommandId",
        "status",
        "materialVersion",
        "expiresAt"
      ],
      "properties": {
        "version": { "const": 1 },
        "challengeId": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "cellId": { "$ref": "#/$defs/uuid" },
        "runtimeCommandId": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["PENDING", "CONSUMED", "EXPIRED", "CANCELLED"] },
        "materialVersion": { "const": 0 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "mediaManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "index",
        "providerMediaId",
        "kind",
        "mime",
        "byteLength",
        "providerChecksum",
        "fetchRef",
        "byteState"
      ],
      "properties": {
        "version": { "const": 1 },
        "index": { "type": "integer", "minimum": 0, "maximum": 19 },
        "providerMediaId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "kind": { "enum": ["IMAGE", "VIDEO", "AUDIO", "FILE", "STICKER", "OTHER"] },
        "mime": { "type": ["string", "null"], "minLength": 3, "maxLength": 255 },
        "byteLength": { "type": ["integer", "null"], "minimum": 0, "maximum": 52428800 },
        "providerChecksum": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "fetchRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 2048 },
        "byteState": { "const": "PENDING" }
      }
    },
    "mediaManifest": {
      "type": "array",
      "$comment": "Each entry.index MUST equal its zero-based array position, which also makes indices unique and contiguous.",
      "maxItems": 20,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 0 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 2 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 3 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 4 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 5 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 6 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 7 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 8 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 9 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 10 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 11 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 12 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 13 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 14 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 15 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 16 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 17 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 18 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaManifestEntry" }, { "properties": { "index": { "const": 19 } } }] }
      ],
      "items": false
    },
    "mediaMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestIndex", "mediaId"],
      "properties": {
        "manifestIndex": { "type": "integer", "minimum": 0, "maximum": 19 },
        "mediaId": { "$ref": "#/$defs/uuid" }
      }
    },
    "mediaMappings": {
      "type": "array",
      "maxItems": 20,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 0 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 2 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 3 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 4 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 5 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 6 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 7 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 8 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 9 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 10 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 11 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 12 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 13 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 14 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 15 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 16 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 17 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 18 } } }] },
        { "allOf": [{ "$ref": "#/$defs/mediaMapping" }, { "properties": { "manifestIndex": { "const": 19 } } }] }
      ],
      "items": false
    },
    "providerEvent": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "rawEnvelopeSha256 MUST equal SHA-256(JCS(rawEnvelope)); normalizedSha256 MUST equal SHA-256(JCS(normalized)).",
      "required": [
        "version",
        "eventKind",
        "providerEventId",
        "providerMessageId",
        "providerConversationId",
        "providerSenderId",
        "providerTarget",
        "providerEventType",
        "sourceTimestamp",
        "callbackReceivedAt",
        "rawEnvelope",
        "rawEnvelopeSha256",
        "normalized",
        "normalizedSha256"
      ],
      "properties": {
        "version": { "const": 1 },
        "eventKind": {
          "enum": ["MESSAGE", "REACTION", "DELIVERY_RECEIPT", "SEEN", "TYPING", "MEMBERSHIP", "OTHER"]
        },
        "providerEventId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "providerMessageId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "providerConversationId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "providerSenderId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "providerTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "providerId"],
          "properties": {
            "kind": { "enum": ["PEER", "SALES_GROUP"] },
            "providerId": { "type": "string", "minLength": 1, "maxLength": 255 }
          }
        },
        "providerEventType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceTimestamp": { "type": "string", "format": "date-time" },
        "callbackReceivedAt": { "type": "string", "format": "date-time" },
        "rawEnvelope": {},
        "rawEnvelopeSha256": { "$ref": "#/$defs/sha256" },
        "normalized": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "replyToProviderMessageId", "mediaManifest"],
          "properties": {
            "text": { "type": ["string", "null"] },
            "replyToProviderMessageId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
            "mediaManifest": { "$ref": "#/$defs/mediaManifest" }
          }
        },
        "normalizedSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inboundBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organizationId",
        "accountId",
        "cellId",
        "sessionGeneration",
        "events"
      ],
      "properties": {
        "version": { "const": 1 },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "cellId": { "$ref": "#/$defs/uuid" },
        "sessionGeneration": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/providerEvent" }
        }
      }
    },
    "inboundBatchResult": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "accepted, deduplicated, and quarantined MUST equal the exact counts of matching result statuses; result.index MUST equal its array position.",
      "required": ["version", "requestId", "accepted", "deduplicated", "quarantined", "results"],
      "properties": {
        "version": { "const": 1 },
        "requestId": { "$ref": "#/$defs/uuid" },
        "accepted": { "type": "integer", "minimum": 0, "maximum": 100 },
        "deduplicated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "quarantined": { "type": "integer", "minimum": 0, "maximum": 100 },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index", "status", "inboundEventId", "messageId", "decisionId",
                  "decisionKind", "noSendReason", "workItemId"
                  ,"media"
                ],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 99 },
                  "status": { "const": "ACCEPTED" },
                  "inboundEventId": { "$ref": "#/$defs/uuid" },
                  "messageId": { "$ref": "#/$defs/uuid" },
                  "decisionId": { "$ref": "#/$defs/uuid" },
                  "decisionKind": { "enum": ["NO_SEND", "WORK_ELIGIBLE"] },
                  "noSendReason": { "type": ["string", "null"], "maxLength": 128 },
                  "workItemId": {
                    "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
                  },
                  "media": { "$ref": "#/$defs/mediaMappings" }
                },
                "oneOf": [
                  {
                    "properties": {
                      "decisionKind": { "const": "NO_SEND" },
                      "noSendReason": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "workItemId": { "const": null }
                    }
                  },
                  {
                    "properties": {
                      "decisionKind": { "const": "WORK_ELIGIBLE" },
                      "noSendReason": { "const": null },
                      "workItemId": { "$ref": "#/$defs/uuid" }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "status", "inboundEventId", "media"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 99 },
                  "status": { "const": "DUPLICATE" },
                  "inboundEventId": { "$ref": "#/$defs/uuid" },
                  "media": { "$ref": "#/$defs/mediaMappings" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "status", "collisionKind"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 99 },
                  "status": { "const": "QUARANTINED" },
                  "collisionKind": {
                    "enum": ["CROSS_KIND", "PAIR_MISMATCH", "PAYLOAD_MISMATCH", "FINGERPRINT_COLLISION"]
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["accepted"], "properties": { "accepted": { "const": 0 } } },
          "then": { "properties": { "results": { "not": { "contains": { "required": ["status"], "properties": { "status": { "const": "ACCEPTED" } } } } } } },
          "else": { "properties": { "results": { "contains": { "required": ["status"], "properties": { "status": { "const": "ACCEPTED" } } } } } }
        },
        {
          "if": { "required": ["deduplicated"], "properties": { "deduplicated": { "const": 0 } } },
          "then": { "properties": { "results": { "not": { "contains": { "required": ["status"], "properties": { "status": { "const": "DUPLICATE" } } } } } } },
          "else": { "properties": { "results": { "contains": { "required": ["status"], "properties": { "status": { "const": "DUPLICATE" } } } } } }
        },
        {
          "if": { "required": ["quarantined"], "properties": { "quarantined": { "const": 0 } } },
          "then": { "properties": { "results": { "not": { "contains": { "required": ["status"], "properties": { "status": { "const": "QUARANTINED" } } } } } } },
          "else": { "properties": { "results": { "contains": { "required": ["status"], "properties": { "status": { "const": "QUARANTINED" } } } } } }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/qrChallenge" },
    { "$ref": "#/$defs/inboundBatch" },
    { "$ref": "#/$defs/inboundBatchResult" }
  ],
  "unevaluatedProperties": false
}
