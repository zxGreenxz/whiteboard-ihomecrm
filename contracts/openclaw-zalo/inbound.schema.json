{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihome.invalid/openclaw-zalo/inbound.schema.json",
  "title": "OpenClaw QR and inbound-event contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qrChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "challengeId",
        "organizationId",
        "accountId",
        "cellId",
        "runtimeCommandId",
        "status",
        "materialVersion",
        "expiresAt"
      ],
      "properties": {
        "version": { "const": 1 },
        "challengeId": { "$ref": "#/$defs/uuid" },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "cellId": { "$ref": "#/$defs/uuid" },
        "runtimeCommandId": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["PENDING", "CONSUMED", "EXPIRED", "CANCELLED"] },
        "materialVersion": { "const": 0 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "providerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "eventKind",
        "providerEventId",
        "providerMessageId",
        "targetKind",
        "targetProviderId",
        "providerOccurredAt",
        "payloadHash",
        "payload"
      ],
      "properties": {
        "version": { "const": 1 },
        "eventKind": {
          "enum": ["MESSAGE", "REACTION", "RECALL", "TYPING", "SEEN", "DELIVERY_RECEIPT", "HISTORY_SYNC"]
        },
        "providerEventId": { "type": ["string", "null"], "maxLength": 255 },
        "providerMessageId": { "type": ["string", "null"], "maxLength": 255 },
        "targetKind": { "enum": ["PEER", "SALES_GROUP"] },
        "targetProviderId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "providerOccurredAt": { "type": "string", "format": "date-time" },
        "payloadHash": { "$ref": "#/$defs/sha256" },
        "payload": { "type": "object" }
      }
    },
    "inboundBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organizationId",
        "accountId",
        "cellId",
        "sessionGeneration",
        "events"
      ],
      "properties": {
        "version": { "const": 1 },
        "organizationId": { "$ref": "#/$defs/uuid" },
        "accountId": { "$ref": "#/$defs/uuid" },
        "cellId": { "$ref": "#/$defs/uuid" },
        "sessionGeneration": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/providerEvent" }
        }
      }
    },
    "inboundBatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "accepted", "deduplicated", "quarantined", "results"],
      "properties": {
        "version": { "const": 1 },
        "accepted": { "type": "integer", "minimum": 0 },
        "deduplicated": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "state", "inboundEventId"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "state": { "enum": ["ACCEPTED", "DEDUPLICATED", "QUARANTINED"] },
              "inboundEventId": {
                "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/qrChallenge" },
    { "$ref": "#/$defs/inboundBatch" },
    { "$ref": "#/$defs/inboundBatchResult" }
  ],
  "unevaluatedProperties": false
}
