  "reproduction_scan_sql": "WITH bad AS (\n SELECT i.id invoice_id,i.contract_id,i.invoice_number,i.billing_month,i.total_amount,i.paid_amount,i.status invoice_status,\n   it.id item_id,it.description,it.amount,\n   EXISTS(SELECT 1 FROM public.invoice_audit_log inserted\n     JOIN public.invoice_audit_log removed ON removed.invoice_id=inserted.invoice_id AND removed.created_at=inserted.created_at\n       AND removed.entity='item' AND removed.action='DELETE' AND removed.before->>'accounting_class'='DEPOSIT'\n       AND removed.before->>'description'=inserted.after->>'description'\n       AND (removed.before->>'amount')::numeric=(inserted.after->>'amount')::numeric\n     WHERE inserted.entity_id=it.id AND inserted.action='INSERT' AND inserted.entity='item'\n       AND inserted.after->>'accounting_class'='REVENUE') AS audit_confirmed\n FROM public.invoice_items it JOIN public.invoices i ON i.id=it.invoice_id\n WHERE i.organization_id='aaaa0000-0000-4000-8000-000000000001' AND i.deleted_at IS NULL AND i.status <> 'CANCELLED'\n   AND it.accounting_class <> 'DEPOSIT' AND it.amount>0\n), grouped AS (\n SELECT invoice_id,contract_id,invoice_number,billing_month,total_amount,paid_amount,invoice_status,\n   sum(amount) misclassified_amount,bool_or(audit_confirmed) audit_confirmed\n FROM bad WHERE audit_confirmed GROUP BY invoice_id,contract_id,invoice_number,billing_month,total_amount,paid_amount,invoice_status\n), affected AS (\n SELECT g.*, c.contract_number,c.status contract_status,c.total_deposit,c.deposit_paid,c.deposit_remaining,\n   b.name building,r.name room,\n   GREATEST(LEAST(g.misclassified_amount,g.paid_amount-(g.total_amount-g.misclassified_amount)),0) AS paid_misclassified,\n   (SELECT jsonb_agg(jsonb_build_object('id',ie.id,'code',ie.code,'status',ie.approval_status,'kind',ie.commission_kind,'amount',ie.total_amount))\n      FROM public.income_expenses ie WHERE ie.contract_id=c.id AND ie.deleted_at IS NULL AND ie.approval_status <> 'CANCELLED'\n        AND (ie.system_source='contract.commission' OR ie.commission_kind IN ('broker','sale'))) AS commissions\n FROM grouped g JOIN public.contracts c ON c.id=g.contract_id AND c.deleted_at IS NULL\n JOIN public.rooms r ON r.id=c.room_id JOIN public.buildings b ON b.id=r.building_id\n)\nSELECT jsonb_build_object('invoice_count',(SELECT count(*) FROM affected),'commission_contracts',(SELECT count(DISTINCT contract_id) FROM affected WHERE commissions IS NOT NULL),\n 'rows',(SELECT jsonb_agg(to_jsonb(a) ORDER BY building,room) FROM affected a)) AS scan;\r\n"
