# Public application configuration. Never put OAuth secrets or Gmail tokens here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Production: /api/bank-email uses the same-origin bridge and existing CSP.
# Configure BANK_EMAIL_WORKER_URL + APP_ORIGIN on the Vercel server separately.
# Empty keeps setup unavailable. Local development may use a loopback worker URL.
VITE_BANK_EMAIL_WORKER_URL=
