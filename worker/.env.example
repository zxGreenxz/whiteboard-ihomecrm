# Copy thành .env và điền giá trị thật. KHÔNG commit .env.
# Service-role key: Supabase Dashboard ▸ Project Settings ▸ API ▸ service_role.
# ⚠️ Bí mật tuyệt đối — chỉ để trên máy bạn/VPS, KHÔNG đưa vào frontend/Vercel.
SUPABASE_URL=https://tryymsxyyckgbrmmvozx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kho ảnh sale công khai, cùng giá trị VITE_R2_PUBLIC_BASE của web (nếu dùng R2).
# Worker chỉ tải room-sale-images từ host này; không dùng khóa R2 riêng tư.
R2_PUBLIC_BASE=

# Khoá mã hoá phiên Zalo at-rest (AES-256-GCM) — 64 ký tự hex, BẮT BUỘC.
# Worker từ chối chạy nếu thiếu. Sinh khoá:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Đổi khoá = mọi phiên đã lưu không giải mã được nữa (phải quét QR lại).
ZALO_SESSION_KEY=

# (Tuỳ chọn) Giới hạn worker này CHỈ phục vụ một số công ty (organization_id,
# phân cách bằng dấu phẩy). Để trống = phục vụ tất cả — tách bạch dữ liệu giữa
# các công ty đã nằm ở DB (organization_id NOT NULL + RLS org-scoped).
WORKER_ORG_IDS=
